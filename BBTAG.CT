{$lua}
if syntaxcheck then return end
core.script.bbscriptCommandPatches = {}
core.script.bbscriptCommandPatches.cmd = {}
core.script.bbscriptCommandPatches.cmd[20011] = {}
local cmd20011 = {}
cmd20011.patches = {}
local result = AoBTools.ScanAoBTable({
    {"83 * * * * * 01 75 * E8 * * * * * 8B", 0x7}
}, core.game.moduleAddress, core.game.moduleEndAddress)
cmd20011.patches.main = {}
cmd20011.patches.main.Address = result
result = AoBTools.ScanAoBTable({
    {"6A 00 8B"}
}, result, core.game.moduleEndAddress)
cmd20011.patches.resetP1 = {}
cmd20011.patches.resetP1.Address = result
result = AoBTools.ScanAoBTable({
    {"6A 01 8B"}
}, result, core.game.moduleEndAddress)
cmd20011.patches.resetP2 = {}
cmd20011.patches.resetP2.Address = result

result = AoBTools.ScanAoBTable({
    {"E8 * * * * 8B 56 * 8B CB", 0x5}
}, result, core.game.moduleEndAddress)
cmd20011.patches.opponentCheck = {}
cmd20011.patches.opponentCheck.origBytes = {}
table.insert(cmd20011.patches.opponentCheck.origBytes, readBytes(result, 0x5, true))
cmd20011.patches.opponentCheck.OrigByte = readByteSigned(result+0x2)
cmd20011.patches.opponentCheck.Address = result

result = AoBTools.ScanAoBTable({
    {"8B * * 39 * * 75"}
}, result, core.game.moduleEndAddress)
cmd20011.patches.opponentCheck2 = {}
cmd20011.patches.opponentCheck2.origBytes = {}
table.insert(cmd20011.patches.opponentCheck2.origBytes, readBytes(result, 0x6, true))
cmd20011.patches.opponentCheck2.CopyBytes = readBytes(result, 0x3, true)
cmd20011.patches.opponentCheck2.Address = result
cmd20011.patches.opponentCheck.JMPOff = cmd20011.patches.opponentCheck2.Address - (cmd20011.patches.opponentCheck.Address+0x5)

result = AoBTools.ScanAoBTable({
    {"2B C2"}
}, result, core.game.moduleEndAddress)
cmd20011.patches.opponentCheck3 = {}
cmd20011.patches.opponentCheck3.Address = result

core.script.bbscriptCommandPatches.cmd[20011] = cmd20011
{$asm}

