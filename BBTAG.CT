                    <CheatEntry>
                      <ID>21601</ID>
                      <Description>"Pat Shape Interpolation Implementation"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
autoAssemble([[
alloc(PatShapeInterpolation,$1000,BBTAG.exe)
registersymbol(PatShapeInterpolation)
]])

{$asm}
label(ArcDzDrad)
label(RingDzDrad)
label(PatInterp)
label(PatInterpDone)

BBTAG.exe+3964B1:
  jmp ArcWidth



BBTAG.exe+396B98:
  jmp RingRadius

BBTAG.exe+396BA1:
  jmp RingLength

// dz / drad (added)
BBTAG.exe+3964C8:
  jmp ArcDzDrad
  db 90
BBTAG.exe+396BB8:
  jmp RingDzDrad
  db 90

PatShapeInterpolation:
ArcWidth:
  mov ecx,[eax+10] // Grabs Current Shape Length Value
  push esi //push from original func
  push edx
  push ebx
  push eax
  mov esi,[ebp+3c]//get required ebx
  mov eax,[esi-658]//stores future shape addr
  test eax,eax
  je NoArcWidthInterpolation
  mov ebx,[esi-60C]//gets prop layer number
  mov eax,[eax+ebx*4+20]//gets prop layer addr
  test eax,eax
  je NoArcWidthInterpolation
  mov eax,[eax]//gets shape number offset
  mov ebx,[esi-66C]//gets some sort of base
  mov eax,[ebx+eax*4+177C]//gets shapenumber array offset
  mov ebx,[ebx+2EF8]
  mov eax,[ebx+eax*4]//gets shape arg addr
  mov eax,[eax+10]//gets future shape length
  cmp eax,ecx
  je NoArcWidthInterpolation
  mov ebx,[esi-620]//gets Cbase
  mov edx,[ebx+1410]//gets current frame
  mov ebx,[ebx+1414]//gets max frame count
//At this point EAX = future shape length, EBX = max frames, ECX = current length, EDX current frames

  sub eax,ecx
  mov ecx,edx
  xor edx,edx
  test eax,eax
  je NoArcWidthInterpolation
  cvtsi2ss xmm0, eax
  cvtsi2ss xmm1, ebx
  divss   xmm0, xmm1
  cvtsi2ss xmm1, ecx
  mulss   xmm0, xmm1
  cvttss2si ebx, xmm0
  pop eax
