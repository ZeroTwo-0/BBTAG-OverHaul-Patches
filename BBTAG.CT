{$lua}
if syntaxcheck then return end
local result = AoBTools.ScanAoBTable({
    {"68 * * * * * 6A 00 FF * * * * * 6A 00 FF", 0xE}
}, core.game.moduleAddress, core.game.moduleEndAddress)
registerSymbol("Ignore_Post_Quit_After_Error", result, true)
{$asm}

Ignore_Post_Quit_After_Error:
  db EB 06

[DISABLE]

Ignore_Post_Quit_After_Error:
  db 6A 00

unregistersymbol(Ignore_Post_Quit_After_Error)
