if syntaxcheck then return end
[ENABLE]
core.static.vTables.charBase = {}
core.static.vTables.charBase.address = AoBTools.ScanAoBTable({
    {"E8 * * * * 33 * C7 * * * * * 89 * * * * * 89 * * * * * 89 * * * * * 68", 0x9, {AoBTools.AoBPointerType.FarAddress}}
}, core.game.moduleAddress, core.game.moduleEndAddress)
local vTable = nil
local addr = core.static.vTables.charBase.address
local funcAddr = readPointer(addr)
while process and funcAddr and isAddrInModule(funcAddr, process) do
    if not vTable then
        vTable = {}
        setmetatable(vTable, {__index = function(table, key) return table[1] end})
    end
    table.insert(vTable, funcAddr)
    addr = addr + PointerSize
    funcAddr = readPointer(addr)
end
core.static.vTables.charBase.functions = vTable
[DISABLE]
core.static.vTables.charBase = nil
{$asm}
