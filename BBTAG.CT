  <LuaScript>
    <LuaScriptEntry Name=" Script  1 ">--- Cheat Table Tools ---
for i = AddressList.List.Items.Count - 1, 0, -1 do
    AddressList.List.Items[i].collapse()
end
local function loadTableCode(n)
    local t = findTableFile(n)
    if t ~= nil then
        local s = t.Stream
        local c = readStringLocal(s.Memory, s.Size) --t.delete()
        return c ~= nil and loadstring(c)
    end
end
--- Load Table Files ---
local tableFiles = {
    "class.lua",
    "extensions.lua",
    "glib.lua"
}
local incompatibleTableFiles = true
for _,n in ipairs(tableFiles) do incompatibleTableFiles = incompatibleTableFiles and (not findTableFile(n)) end
incompatibleTableFiles = incompatibleTableFiles and findTableFile("File")
if incompatibleTableFiles then
    for _,n in ipairs(tableFiles) do
        local tf = findTableFile("File")
        local s = tf.Stream
        local dirPattern = "(.*[/\\])"
        local moduleDir = lfs.currentdir()
        local tempFilePath = moduleDir.."\\temp.bin"
        s.saveToFile(tempFilePath)
        tablefile_delete(tf)
        createTableFile(n, tempFilePath)
        os.remove(tempFilePath)
    end
end
for _,n in ipairs(tableFiles) do
    loadTableCode(n)()
end
UITools.AddGToolsMenu()

</LuaScriptEntry>
