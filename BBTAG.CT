command_40014: //Will Adjust the Camera Collision with stage wall, will reset if set to 0
command_AdjustCameraBounds:
  mov eax,[ebp+08]
  mov eax,[eax]
  test eax,eax
  je command_ResetCameraBounds
  cvtsi2ss xmm0,eax
  movss [core.static.gamedata.stageCameraSettings.offset+8c], xmm0
  movaps xmm1,xmm0
  mulss xmm1,[command_ResetCameraBounds_cameraHalfScalar]
  movss [core.static.gamedata.stageCameraSettings.offset+94], xmm1
  movaps xmm2,xmm1
  xorps xmm2, xmm2
  subss xmm2, xmm1
  movss [core.static.gamedata.stageCameraSettings.offset+90], xmm2
  jmp command_end
command_ResetCameraBounds:
  mov eax,45700000 // 3840
  mov [core.static.gamedata.stageCameraSettings.offset+8c], eax
  mov eax,c4f00000 // -1920
  mov [core.static.gamedata.stageCameraSettings.offset+90], eax
  mov eax,44f00000 // 1920
  mov [core.static.gamedata.stageCameraSettings.offset+94], eax
  jmp command_end

command_ResetCameraBounds_cameraHalfScalar:
  db 00 00 00 3f


