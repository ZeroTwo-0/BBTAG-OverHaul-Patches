command_40006:
command_WasLastHitBySameCharacter:
  push 16 // Get Opponent
  mov ecx,ebx
  call BBTAG.exe+37CB20
  mov ecx,[ebx+000004A0] // Get Hit Object
  cmp eax,ecx
  je command_WasLastHitBySameCharacter_next
  push 17 // Get Opponent Partner
  mov ecx,ebx
  call BBTAG.exe+37CB20
  mov ecx,[ebx+000004A0] // Get Hit Object
  cmp eax,ecx
  jne command_WasLastHitBySameCharacter_false
command_WasLastHitBySameCharacter_next:
  mov ecx,[eax+000001F4] // Get Opponent Root
  mov eax,[ecx+000028C0]
  cmp eax,ebx
  jne command_WasLastHitBySameCharacter_false
  sub esp,08 // Get Opponent SLOT_30
  mov eax,esp
  mov [eax],00000002
  mov [eax+04],0000001E
  call BBTAG.exe+3634B0
  test eax,eax
  je command_WasLastHitBySameCharacter_false
  sub esp,08 // Get Opponent SLOT_225 (Hit by Point)
  mov eax,esp
  mov [eax],00000002
  mov [eax+04],000000E1
  call BBTAG.exe+3634B0
  push eax
  sub esp,08 // Get Main SLOT_158 (Is Point)
  mov eax,esp
  mov [eax],00000002
  mov [eax+04],0000009E
  call BBTAG.exe+3634B0
