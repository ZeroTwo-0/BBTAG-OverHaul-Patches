                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript Async="1">[ENABLE]
{$lua}
if syntaxcheck then return end
autoAssemble([[
alloc(FateHandler,$10000,BBTAG.exe)
registersymbol(FateHandler)
]])

core.script.YumiFateTakeover = {}
core.script.YumiFateTakeover.FateColor = AoBTools.ScanAoBTable({
    {"85 C0 B9 05 00 00 00 5E", -0x5}
}, core.game.moduleAddress, core.game.moduleEndAddress)

core.script.YumiFateTakeover.FateColor2 = AoBTools.ScanAoBTable({
    {"85 C0 B9 05 00 00 00 5F", -0x5}
}, core.game.moduleAddress, core.game.moduleEndAddress)

core.script.YumiFateTakeover.FateIcon = AoBTools.ScanAoBTable({
    {"E8 * * * * 85 C0 74 * E8 * * * * 8B C8 E8 * * * * 8D 8D "}
}, core.game.moduleAddress, core.game.moduleEndAddress)

core.script.YumiFateTakeover.FateIconXOR = AoBTools.ScanAoBTable({
    {"E8 * * * * 85 C0 74 * E8 * * * * 8B C8 E8 * * * * 8D 8D "},
    {"33 C0"}
}, core.game.moduleAddress, core.game.moduleEndAddress)

core.script.YumiFateTakeover.VsFateIcon1 = AoBTools.ScanAoBTable({
    {"8D 4D * E8 * * * * e8 * * * * 8B C8 e8 * * * * 85 C0 74 *"}
}, core.game.moduleAddress, core.game.moduleEndAddress)

core.script.YumiFateTakeover.VsFateIcon2 = AoBTools.ScanAoBTable({
    {"8D 4D * E8 * * * * e8 * * * * 8B C8 e8 * * * * 85 C0 74 * "}
}, core.script.YumiFateTakeover.VsFateIcon1+0x5, core.game.moduleEndAddress)

core.script.YumiFateTakeover.VsFateBG1 = AoBTools.ScanAoBTable({
    {"56 e8 * * * * 8B C8 e8 * * * * 8B 00"},
    {"83 FE 06", 0x3}
}, core.game.moduleAddress, core.game.moduleEndAddress)

core.script.YumiFateTakeover.VsFateBG2= AoBTools.ScanAoBTable({
    {"56 FF B7 * * * * E8 * * * * 8B C8"},
    {"83 FE 06", 0x3}
}, core.game.moduleAddress, core.game.moduleEndAddress)

core.script.YumiFateTakeover.YumiOriginalFateColorAsm = readBytes(core.script.YumiFateTakeover.FateColor, 0xC, true)
core.script.YumiFateTakeover.YumiOriginalFateColorAsm2 = readBytes(core.script.YumiFateTakeover.FateColor2, 0xC, true)
core.script.YumiFateTakeover.FateIconOriginalCall = readBytes(core.script.YumiFateTakeover.FateIcon, 0x3F, true)
core.script.YumiFateTakeover.VsFateIconOriginalCall2 = readBytes(core.script.YumiFateTakeover.VsFateIcon2, 0x3F, true)
core.script.YumiFateTakeover.VsFateIconOriginalCall1 = readBytes(core.script.YumiFateTakeover.VsFateIcon1, 0x3F, true)
core.script.YumiFateTakeover.VsFateBgOriginalJne1 = readBytes(core.script.YumiFateTakeover.VsFateBG1, 0x7, true)
core.script.YumiFateTakeover.VsFateBgOriginalJne2 = readBytes(core.script.YumiFateTakeover.VsFateBG2, 0x7, true)
local memAddr = getAddressSafe("FateHandler")
{$asm}
core.script.YumiFateTakeover.FateColor:
  call FateHandler
  test eax,eax
  db 90 90 90 90 90
core.script.YumiFateTakeover.FateColor2:
  call FateHandler
  test eax,eax
  db 90 90 90 90 90
core.script.YumiFateTakeover.FateIcon:
  call FateHandler
  jmp FateHandler+3E8
  db 90 90 90


//Jump table for fates per row
BBTAG.exe+2DDAC4+C:    //need to move to larger memory
  dd FateHandler_RwbyRowOverwrite //need to add disable part
//Arcana heart setter
//BBTAG.exe+2DAF88:
  //nop
  //nop

BBTAG.exe+2E3500:
  jmp FateHandler_BarColor
//BBTAG.exe+2DB8F1:
//  jmp FateHandler+0x2d0
//BBTAG.exe+2DB90B:
//  jmp FateHandler+0x300
//BBTAG.exe+2DB925:
//  jmp FateHandler+0x330
BBTAG.exe+2E3480:
  jmp FateHandler_PortraitColor

FateHandler:
  call BBTAG.exe+271E00
  push ebp
  mov ebp,esp
  mov eax,[ebp+08]
  movzx eax,byte ptr [eax+BBTAG.exe+6C1730]
  mov ecx,eax
  pop ebp
  ret 0004

FateHandler_RwbyRowOverwrite:
  imul eax,[ebx+68],00000084
  cmp dword ptr [eax+ebx+000002B0],03
  db 75 09
  mov ecx,ebx
  call BBTAG.exe+2DF510
  db EB 06
  mov eax,[ebx+00000634]
  push eax
  mov [ebp-000000B8],eax
  call BBTAG.exe+271E00
  mov ecx,eax
  call FateHandler
  jmp FateHandler+3E8

FateHandler_BarColor:
  cmp dword ptr [edi+000002B0],04
  push ebp
  mov ebp,esp
  imul eax,[ebp+08],00000084
  je BBTAG.exe.text+2E250A  //AOB referencing jmp
  push edi
  mov edi,[eax+ecx+000002B0]
  cmp edi,03
  jne BBTAG.exe+2E358E
  imul eax,[ecx+68],00000084
  push esi
  cmp [eax+ecx+000002B0],edi
  db 75 09
  call BBTAG.exe+2DF510
  mov esi,eax
  db eb 06
  mov esi,[ecx+00000634]
  push esi
  call BBTAG.exe+271E00
  mov ecx,eax
  call FateHandler
  test eax,eax
  pop esi
  cmovne edi,ecx
  mov eax,edi
  pop edi
  pop ebp
  ret 0004

FateHandler_PortraitColor:
  push ebp
  mov ebp,esp
  imul eax,[ebp+08],00000084
  push eax
  mov eax, [ebp]
  mov eax, [eax-000000AC]
  cmp dword ptr [eax+2b0] ,04
  pop eax
  je BBTAG.exe.text+2E251E
  push esi
  mov esi,[eax+ecx+000002B0]
  cmp esi,03
  jne BBTAG.exe+2E34F6
  mov eax,[ebp+0C]
  push edi
  mov edi,[ecx+eax*8+0000062C]
push edi
call BBTAG.exe+271E00
mov ecx,eax
call BBTAG.exe+2744F0
test eax,eax
db eb 08
pop edi
mov eax,esi
pop esi
pop ebp
ret 0008
push edi
call BBTAG.exe+271E00
mov ecx,eax
call BBTAG.exe+274500
test eax,eax
db eb 0b
pop edi
mov eax,00000006
pop esi
pop ebp
ret 0008
push edi
  call BBTAG.exe+271E00
  mov ecx,eax
  call FateHandler
  test eax,eax
  pop edi
  cmovne esi,ecx
  mov eax,esi
  pop esi
  pop ebp
  ret 0008
FateHandler_PortraitColorExit:
  imul eax,[ebp+08],00000084
  jmp BBTAG.exe.text+2E251E

FateHandler+3E8:
  cmp ecx,3
  jne ArcanaIcon
