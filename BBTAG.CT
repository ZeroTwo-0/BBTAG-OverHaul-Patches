newmem:

charAddExFateCostumeIMG:
  test bl,bl
  je charAddExFateCostumeIMG_orig
  push 00 // IMG
  push eax // Char Slot Address
  mov ecx,[ebp-000000A8]
  push edi
  call BBTAG.exe+27C4F0
  push eax // Char Match Settings
  call func_AppendCostumeString
  jmp charAddExFateCostumeIMG_return
charAddExFateCostumeIMG_orig:
  call core.script.charAddExFateCostumeValues.img.charAddExFateCostumeCall
  jmp charAddExFateCostumeIMG_return

charAddExFateCostumeVRI:
  test bl,bl
  je charAddExFateCostumeVRI_orig
  push 01 // VRI
  push ecx // Char Slot Address
  mov ecx,[ebp-000000A8]
  push edi
  call BBTAG.exe+27C4F0
  push eax // Char Match Settings
  call func_AppendCostumeString
  jmp charAddExFateCostumeVRI_return
charAddExFateCostumeVRI_orig:
  call core.script.charAddExFateCostumeValues.vri.charAddExFateCostumeCall
  jmp charAddExFateCostumeVRI_return

func_AppendCostumeString: // Takes 6 Arguments
  push ebp
  mov ebp,esp
  sub esp,00000084
  push esi
  // Get String Alloc Space ([ebp+14])
  mov eax,[ebp+14]
  test eax,eax
  mov esi,BBTAG.exe+83A670
  cmovne esi,eax
  mov [ebp+14],esi
  //
  // Get Char Short Name Address (EDX)
  imul edx,[ebp+1C],000000B8
  add edx,[ebp+0C]
  //
  mov ecx,[ebp+08] // Char Match Settings
  // Get Fate ID / Index (EAX)
  push [ecx] // Push Char ID / Index
  call BBTAG.exe+27A460
  mov ecx,eax
  call BBTAG.exe+27A470
  //
  // Jump to Fate Specific Append
  mov ecx,func_AppendCostumeString_jmptbl
  mov eax,[ecx+eax*4]
  test eax,eax
  je func_AppendCostumeString_end
  jmp eax
  //
func_AppendCostumeString_Persona:
  mov eax,[ebp+08]
  mov eax,[eax+0C] // Get Costume ID / Index
  and eax,03
func_AppendCostumeString_Persona_Megane:
  test al,01
  je func_AppendCostumeString_Persona_Shadow
  push eax
  push edx
  lea eax,[str_AppendCostumeString_Persona_Megane]
  push eax
  lea esi,[ebp-00000084]
  push esi
  call BBTAG.exe+13D60
  mov edx,esi
  add esp,0C
  pop eax
func_AppendCostumeString_Persona_Shadow:
  test al,02
  je func_AppendCostumeString_Persona_None
  // Skip if IMG
  push eax
  mov eax,[ebp+10]
  test eax,eax
  pop eax
  je func_AppendCostumeString_Persona_None
  //
  push eax
  push edx
  lea eax,[str_AppendCostumeString_Persona_Shadow]
  push eax
  lea esi,[ebp-00000044]
  push esi
  call BBTAG.exe+13D60
  mov edx,esi
  add esp,0C
  pop eax
func_AppendCostumeString_Persona_None:
  jmp func_AppendCostumeString_end

func_AppendCostumeString_end:
  // Final String
  push edx
  push [ebp+18]
  push [ebp+14]
  call BBTAG.exe+13D60
  add esp,0C
  mov eax,[ebp+14]
  //
  pop esi
  mov esp,ebp
  pop ebp
  ret 0018


func_AppendCostumeString_jmptbl:
  dd 00
  dd func_AppendCostumeString_Persona
  dd 00
  dd 00
  dd 00
  dd 00
  dd 00
  dd 00
  dd 00
  dd 00
  dd 00
  dd 00

str_AppendCostumeString_Persona_Megane:
  db 25 73 5F 6D 00 00 00 00 // "%s_m"

str_AppendCostumeString_Persona_Shadow:
  db 25 73 5F 73 00 00 00 00 // "%s_s"

Character_Add_Ex_Fate_Costume_IMG:
  jmp charAddExFateCostumeIMG
charAddExFateCostumeIMG_return:

Character_Add_Ex_Fate_Costume_VRI:
  jmp charAddExFateCostumeVRI
charAddExFateCostumeVRI_return:

[DISABLE]

