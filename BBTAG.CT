CharBase_Extended_Memory_CleanupFunc:
  push eax
  push ebx
  push ecx
  push edx
  xor eax,eax
  xor edx,edx
  mov ebx,000004B0*0000001C
  mov ecx,CharBase_Extended_Memory
CharBase_Extended_Memory_CleanupFunc_loop:
  cmp edx,4DC
  je CharBase_Extended_Memory_CleanupFunc_loop_Bypass
  cmp edx,514
  je CharBase_Extended_Memory_CleanupFunc_loop_Bypass
  cmp edx,518
  je CharBase_Extended_Memory_CleanupFunc_loop_Bypass
  cmp edx,98C
  je CharBase_Extended_Memory_CleanupFunc_loop_Bypass
  cmp edx,E3C
  je CharBase_Extended_Memory_CleanupFunc_loop_Bypass
  cmp edx,12EC
  je CharBase_Extended_Memory_CleanupFunc_loop_Bypass
  mov [ecx+edx],eax
CharBase_Extended_Memory_CleanupFunc_loop_Bypass:
  add edx,04
  cmp edx,ebx
  jb CharBase_Extended_Memory_CleanupFunc_loop
  pop edx
  pop ecx
  pop ebx
  pop eax
  ret
registersymbol(CharBase_Extended_Memory_CleanupFunc)

// CharBase Memory

CharBase_Extended_Memory:
{$lua}
if syntaxcheck then return end
local memSize = 0x4B0
local objLimit = 0x1D --0x194
local asmStr = ''
local memPtrSetupLabel = 'CharBase_Extended_Memory_Pointers'
local memPtrSetupLabelStr = memPtrSetupLabel .. ':\n'
for objectID=0x1,objLimit do
    local labelStr = 'CharBase_Extended_Memory_ControlObject'..objectID
    local s='db '
    for i=0x1,memSize do
        s=s..'00 '
    end
    asmStr = asmStr .. labelStr ..':\n' .. s .. '\n'
    memPtrSetupLabelStr = memPtrSetupLabelStr .. 'dd ' .. labelStr .. '\n'
end
memPtrSetupLabelStr = memPtrSetupLabelStr .. 'registersymbol(' .. memPtrSetupLabel .. ')'
return asmStr .. memPtrSetupLabelStr
{$asm}
registersymbol(CharBase_Extended_Memory)

[DISABLE]

unregistersymbol(SLOT_Get_Set_Override_Getters_Pointers)
unregistersymbol(SLOT_Get_Set_Override_Setters_Pointers)
unregistersymbol(CharBase_Extended_Memory)
unregistersymbol(CharBase_Extended_Memory_Pointers)
unregistersymbol(CharBase_Extended_Memory_CleanupFunc)

dealloc(SLOT_Get_Set_Override_Memory)
unregistersymbol(SLOT_Get_Set_Override_Memory)
</AssemblerScript>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>21541</ID>
                      <Description>"BBScript Command Extension"</Description>
                      <Options moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript Async="1">[ENABLE]
{$lua}
if syntaxcheck then return end
if not GeneralTools.WaitForCondition(function()
    return (core ~= nil and
            core.static ~= nil and
            core.static.vTables ~= nil and
            core.static.vTables.charBase ~= nil and
            core.static.vTables.charBase.functions ~= nil)
        end, 60, 3000) then
    error("Wait condition failed.")
end
local commandReader = AoBTools.ScanAoBTable({
    {"8B * * * * * 85 * 74 * * E8 * * * * 83 * * 75", 0xC, {AoBTools.AoBPointerType.NearAddress}},
    {"E8 * * * * 8B * 3B * 75", 0x1, {AoBTools.AoBPointerType.NearAddress}},
    {"74 * 83 * * 75 * 8B * * * * * F6", 0x6, {AoBTools.AoBPointerType.CloseJump}},
    {"83 * * 75 * E8", 0x4, {AoBTools.AoBPointerType.CloseJump}}
}, core.static.vTables.charBase.functions[19], core.game.moduleEndAddress)
core.script.bbscriptCommandExtension = {}

core.script.bbscriptCommandExtension.AdditionalCases = 0x1F4 -- 500

local repeatAoBTbl = {"0F 87 * * * * 0F 84", 0x2, {AoBTools.AoBPointerType.FarJump}}
local result = AoBTools.ScanAoBTable({
    {"E8 * * * *", 0x1, {AoBTools.AoBPointerType.NearAddress}},
    repeatAoBTbl,
    repeatAoBTbl,
    repeatAoBTbl,
    repeatAoBTbl,
    repeatAoBTbl,
    repeatAoBTbl,
    repeatAoBTbl,
    repeatAoBTbl,
    repeatAoBTbl,
    repeatAoBTbl,
    repeatAoBTbl,
    repeatAoBTbl,
    repeatAoBTbl,
    repeatAoBTbl,
    repeatAoBTbl,
    {"81 C6 * * * * 83 * * 0F 87"}
}, commandReader, core.game.moduleEndAddress)
core.script.bbscriptCommandExtension.OrigAddBytes = readBytes(result+0x2, 0x4, true)

core.script.bbscriptCommandExtension.AddVal = readIntegerSigned(result+0x2)
core.script.bbscriptCommandExtension.JAAddress = result+0xB + readIntegerSigned(result+0xB) + 0x4
core.script.bbscriptCommandExtension.Address = result

local commandSizeCheck = AoBTools.ScanAoBTable({
    {"8B * * * * * E8", 0x7, {AoBTools.AoBPointerType.NearAddress}},
}, commandReader, core.game.moduleEndAddress)

local result = AoBTools.ScanAoBTable({
    {"33 * BE * * * *", 0x3}
}, commandSizeCheck, core.game.moduleEndAddress)

core.script.bbscriptCommandExtension.OrigSizeVal = readIntegerSigned(result)
core.script.bbscriptCommandExtension.ParseList = {}
core.script.bbscriptCommandExtension.ParseList.SizeInfo = {}
core.script.bbscriptCommandExtension.ParseList.SizeInfo.Address = result


result = AoBTools.ScanAoBTable({
    {"8B * * * * * * 3B * 74 *", 0x3}
}, commandSizeCheck, core.game.moduleEndAddress)

core.script.bbscriptCommandExtension.OrigParseTableAddr = readPointer(result)
core.script.bbscriptCommandExtension.ParseList.Pointer = result

result = (result+0x7 + readByteSigned(result+0x7) + 0x1) + 0x3

core.script.bbscriptCommandExtension.OrigParseTableSizeAddr = readPointer(result)
core.script.bbscriptCommandExtension.ParseList.SizeInfo.Pointer = result
{$asm}
alloc(bbscextmem,$10000,$core.script.bbscriptCommandExtension.Address)

label(bbscriptCommandExtension)
label(bbscriptCommandExtension_return)

bbscextmem:

bbscriptCommandExtension:
  cmp esi,00009C40 // 40000
  jae bbscriptCommandExtension_newCommands
  add esi,core.script.bbscriptCommandExtension.AddVal
  jmp bbscriptCommandExtension_return
bbscriptCommandExtension_newCommands:
  add esi,FFFF63C0 // -40000
  cmp esi,core.script.bbscriptCommandExtension.AdditionalCases-1
  ja core.script.bbscriptCommandExtension.JAAddress
  jmp dword ptr [esi*4+bbscriptCommandExtension_pointers]

