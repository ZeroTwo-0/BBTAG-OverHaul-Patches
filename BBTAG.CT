                  <ID>21537</ID>
                  <Description>"JONB Extended Mask Condition"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript Async="1">[ENABLE]
{$lua}
if syntaxcheck then return end
core.script.jonbMaskCond = {}

core.script.jonbMaskCond.sprite = {}
local result = AoBTools.ScanAoBTable({
    {"83 * * 75 * 83 * * 00 0F 85 * * * * 8D",0x1},
    {"FF D0 D8",0x2}
}, core.game.moduleAddress, core.game.moduleEndAddress)

core.script.jonbMaskCond.sprite.origMaskByte = readByteSigned(result+0x2)
core.script.jonbMaskCond.sprite.origJNE = result+0x4 + readByteSigned(result+0x4) + 0x1
core.script.jonbMaskCond.sprite.origBytes = readBytes(result, 0x6, true)
registerSymbol("JONB_Sprite_Mask_Condition", result, true)
core.script.jonbMaskCond.origJA = AoBTools.ScanAoBTable({
    {"83 * * 0F 87 * * * *", 0x5, {AoBTools.AoBPointerType.FarJump}}
}, result, core.game.moduleEndAddress)

core.script.jonbMaskCond.pat = {}
result = AoBTools.ScanAoBTable({
    {"83 * * 00 75 * F3 * * * * * * * 8B"}
}, core.game.moduleAddress, core.game.moduleEndAddress)

core.script.jonbMaskCond.pat.origOff = readByteSigned(result+0x2)
core.script.jonbMaskCond.pat.origJNE = result+0x5 + readByteSigned(result+0x5) + 0x1
core.script.jonbMaskCond.pat.origBytes = readBytes(result, 0x6, true)
registerSymbol("JONB_PAT_Mask_Condition", result, true)
{$asm}
alloc(newmem,$1000)

label(jonbMaskCond_Sprite)
label(jonbMaskCond_Sprite_return)

label(jonbMaskCond_PAT)
label(jonbMaskCond_PAT_return)

newmem:

jonbMaskCond_Sprite:
  mov ebx, [eax+edx*8+40]
  push eax
  mov ecx,[edi+000001F4]
  push ebx
  call func_maskCheck
  add esp,04
  test eax,eax
  pop eax
  je jonbMaskCond_Sprite_end
  fmul dword ptr [ebp-000007A4]
  jmp jonbMaskCond_Sprite_return
jonbMaskCond_Sprite_end:
  fmul dword ptr [MultiplyBy0]
  jmp jonbMaskCond_Sprite_return
MultiplyBy0:
  db 00 00 00 00

jonbMaskCond_PAT:
  cmp dword ptr [ebp+core.script.jonbMaskCond.pat.origOff],00
  jne core.script.jonbMaskCond.pat.origJNE
  mov eax,[esi]
  mov ecx,esi
  push [ebp-00000748]
  mov eax,[eax+50]
  call eax // Masking Value
  mov ecx,[edi+000001F4]
  push eax
  call func_maskCheck
  add esp,04
  test eax,eax
  jne jonbMaskCond_PAT_return
  jmp core.script.jonbMaskCond.pat.origJNE

func_maskCheck:
  push ebp
  mov ebp,esp
  push ebx
  call func_getCustomMaskSlot
  mov ebx,eax
  mov eax,[ebp+08]
jonbMaskCond_Sprite_masking_check_1:
  cmp eax,0A
  jne jonbMaskCond_Sprite_masking_check_2
  test ebx,1
  je func_maskCheck_false
  jmp func_maskCheck_true
jonbMaskCond_Sprite_masking_check_2:
  cmp eax,0B
  jne func_maskCheck_true
  test ebx,2
  je func_maskCheck_false
func_maskCheck_true:
  mov eax,1
  jmp func_maskCheck_end
func_maskCheck_false:
  xor eax,eax
func_maskCheck_end:
  pop ebx
  mov esp,ebp
  pop ebp
  ret

func_getCustomMaskSlot:
  sub esp,08
  mov eax,esp
  mov [eax],00000002
  mov [eax+04],000000DF
  call BBTAG.exe+3634B0
  ret


JONB_Sprite_Mask_Condition:
  jmp jonbMaskCond_Sprite
  db 90
jonbMaskCond_Sprite_return:

JONB_PAT_Mask_Condition:
  jmp jonbMaskCond_PAT
  nop
jonbMaskCond_PAT_return:

[DISABLE]
{$lua}
if syntaxcheck then return end
writeBytes(getAddressSafe("JONB_Sprite_Mask_Condition"), core.script.jonbMaskCond.sprite.origBytes)
writeBytes(getAddressSafe("JONB_PAT_Mask_Condition"), core.script.jonbMaskCond.pat.origBytes)
core.script.jonbMaskCond = nil
{$asm}
unregistersymbol(JONB_Sprite_Mask_Condition)
unregistersymbol(JONB_PAT_Mask_Condition)
dealloc(newmem)
</AssemblerScript>
