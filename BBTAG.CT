                </CheatEntry>
                <CheatEntry>
                  <ID>5137</ID>
                  <Description>"Custom Functions"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript Async="1">[ENABLE]
alloc(customfuncmem,$10000)

label(Custom_IsActiveFlowCrossRushResonanceActive)
label(Custom_IsResonanceActive)
label(Custom_IsCrossRushActive)

customfuncmem:

Custom_IsActiveFlowCrossRushResonanceActive:
  push ecx
  push esi
  xor esi,esi
  call BBTAG.exe+3B8BE0 // Check Active Flow Status
  or esi,eax
  mov ecx,ebx
  call Custom_IsResonanceActive
  or esi,eax
  mov ecx,ebx
  call Custom_IsCrossRushActive
  or esi,eax
  mov eax,esi
  pop esi
  pop ecx
  ret

Custom_IsResonanceActive:
  push ebx
  push edx
  push ecx
  call BBTAG.exe+2BD5A0
  pop ecx
  mov ebx,eax
  mov eax,[ecx+30]
  and eax,80000001
  db 79 05 // JNS
  dec eax
  or eax,-02
  inc eax
  mov ecx,ebx
  push eax
  call BBTAG.exe+2BD860
  pop edx
  pop ebx
  ret

Custom_IsCrossRushActive:
  push ebx
  push ecx
  call BBTAG.exe+2BD5A0
  pop ecx
  mov ebx,eax
  mov eax,[ecx+30]
  and eax,80000001
  db 79 05 // JNS
  dec eax
  or eax,-02
  inc eax
  mov ecx,ebx
  push eax
  call BBTAG.exe+2BD820
  pop ebx
  ret

Custom_GetResonanceLevel:
  push ebx
  push edx
  xor edx,edx
  mov ebx,[ecx+30] // Get Player Side
  and ebx,1
  call BBTAG.exe+2BD5A0 // Get Match System Values
  imul ecx,[eax+ebx*4+20],64 // Get Resonance Level Percentage
  mov eax,14F8B589
  imul ecx
  sar edx,0D
  mov eax,edx
  shr eax,1F
  add eax,edx
  mov ebx,eax
Custom_GetResonanceLevel_4:
  cmp ebx,64
  jl Custom_GetResonanceLevel_3
  mov eax,00000004
  jmp Custom_GetResonanceLevel_end
Custom_GetResonanceLevel_3:
  cmp ebx,42
  jle Custom_GetResonanceLevel_2
  mov eax,00000003
  jmp Custom_GetResonanceLevel_end
Custom_GetResonanceLevel_2:
  cmp ebx,21
  jle Custom_GetResonanceLevel_1
  mov eax,00000002
  jmp Custom_GetResonanceLevel_end
Custom_GetResonanceLevel_1:
  mov eax,00000001
Custom_GetResonanceLevel_end:
  pop edx
  pop ebx
  ret

registersymbol(Custom_IsActiveFlowCrossRushResonanceActive)
registersymbol(Custom_IsResonanceActive)
registersymbol(Custom_IsCrossRushActive)
registersymbol(Custom_GetResonanceLevel)

[DISABLE]

unregistersymbol(Custom_IsActiveFlowCrossRushResonanceActive)
unregistersymbol(Custom_IsResonanceActive)
unregistersymbol(Custom_IsCrossRushActive)
unregistersymbol(Custom_GetResonanceLevel)
dealloc(customfuncmem)

