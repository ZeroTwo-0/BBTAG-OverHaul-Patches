local addr = AoBTools.ScanAoBTable({
    {"83 FB 13 0F 87 * * * * FF 24 9D * * * * 8B"}
}, core.game.moduleAddress, core.game.moduleEndAddress)
registerSymbol("Hitstun_ID_Switch_Override", addr, true)
core.script.hitstunIDSwitchOverride = {}
core.script.hitstunIDSwitchOverride.LastIndex = readByte(addr+0x2)
core.script.hitstunIDSwitchOverride.OrigSwitchPointerBytes = readBytes(addr+0xC, 0x4, true)
local ptrTblAddr = readPointer(addr+0xC)
local newPtrTblAddr = getAddressSafe("Hitstun_ID_Switch_Override_Pointers")

local ptrTbl = {}

for i=0x0,core.script.hitstunIDSwitchOverride.LastIndex do
    local off = (i)*0x4
    table.insert(ptrTbl, readPointer(ptrTblAddr+off))
end

--- Fix Harecode
local bDownCrashAddr = AoBTools.ScanAoBTable({
    {"74 * 68", 0x3, {AoBTools.AoBPointerType.FarAddress}}
}, ptrTbl[0x1+0x1], core.game.moduleEndAddress)

core.script.hitstunIDSwitchOverride.DownCrashAddr = AoBTools.ScanAoBTable({
    {"74 * 68", 0x3}
}, ptrTbl[0xC+0x1], core.game.moduleEndAddress)

core.script.hitstunIDSwitchOverride.OrigDownCrashAddr = AoBTools.ScanAoBTable({
    {"74 * 68", 0x3, {AoBTools.AoBPointerType.FarAddress}}
}, ptrTbl[0xC+0x1], core.game.moduleEndAddress)

writeInteger(core.script.hitstunIDSwitchOverride.DownCrashAddr, bDownCrashAddr)

core.script.hitstunIDSwitchOverride.OrigHardcodeIDAddr = AoBTools.ScanAoBTable({
    {"83 FB 12 75", 0x2}
}, ptrTbl[0x13], ptrTbl[0x13]+0x100)
writeByte(core.script.hitstunIDSwitchOverride.OrigHardcodeIDAddr, readByte(core.script.hitstunIDSwitchOverride.OrigHardcodeIDAddr)+0x1)

ptrTbl[0xF+0x1] = getAddressSafe("Hitstun_ID_Switch_Override_CmnActYokoSpin")

table.insert(ptrTbl, (0x11 + 0x1), getAddressSafe("Hitstun_ID_Switch_Override_CmnActSlideAir"))

for i,ptr in ipairs(ptrTbl) do
    writePointer(newPtrTblAddr+((i-0x1)*0x4), ptr)
end

writeByte(addr+0x2, #ptrTbl-0x1)
writePointer(addr+0xC, newPtrTblAddr)
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
local addr = getAddressSafe("Hitstun_ID_Switch_Override")
writeByte(addr+0x2, core.script.hitstunIDSwitchOverride.LastIndex)
writeBytes(addr+0xC, core.script.hitstunIDSwitchOverride.OrigSwitchPointerBytes)

--- Undo Fix Hardcode
writeByte(core.script.hitstunIDSwitchOverride.OrigHardcodeIDAddr, readByte(core.script.hitstunIDSwitchOverride.OrigHardcodeIDAddr) - 0x1)
writeInteger(core.script.hitstunIDSwitchOverride.DownCrashAddr, core.script.hitstunIDSwitchOverride.OrigDownCrashAddr)
core.script.hitstunIDSwitchOverride = nil
{$asm}

