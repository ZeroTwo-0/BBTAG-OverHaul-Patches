                  <AssemblerScript Async="1">[ENABLE]
alloc(missingfuncmem,$10000)

label(Izanami_Time_Stop_Check)

label(Instant_Block_Check)

label(OverDrive_Burst_Meter_Stock_Check)
label(overDriveBurstMeterStockCheck_cancel)
label(overDriveBurstMeterStockCheck_sub)
label(overDriveBurstMeterStockCheck_sub2)
label(overDriveBurstMeterStockCheck_sub2_cancel)
label(overDriveBurstMeterStockCheck_sub2_loop)
label(overDriveBurstMeterStockCheck_valTbl)
label(OverDrive_Burst_Meter_Stock_Check_getValTbl)
label(OverDrive_Burst_Meter_Stock_Check_checkValTbl)

label(Modify_Barrier)

define(izanamiSlotID, 4F)

missingfuncmem:

Izanami_Time_Stop_Check:
  cmp dword ptr [ecx+34],izanamiSlotID
  db 75 21 // JNE
  sub esp,08
  mov eax,esp
  mov [eax],00000002
  mov [eax+04],0000000B
  call BBTAG.exe+3634B0
  test eax,eax
  db 7E 06 // JLE
  mov eax,00000001
  ret
  xor eax,eax
  ret

Instant_Block_Check:
  push esi
  push edi
  mov edi,ecx
  push [edi+30]
  call BBTAG.exe+2CC240
  mov ecx,eax
  call BBTAG.exe+2CA500
  test eax,eax
  db 74 33 // JE
  mov esi,[edi+30]
  call BBTAG.exe+2CC240
  cmp dword ptr [eax+esi*4+0001AFCC],01
  db 74 6F // JE
  mov esi,[edi+30]
  call BBTAG.exe+2CC240
  cmp dword ptr [eax+esi*4+0001AFCC],03
  db 74 5D // JE
  mov eax,[edi+0000025C]
  shr eax,1B
  pop edi
  and eax,01
  pop esi
  ret
  push [edi+30]
  call BBTAG.exe+4E2F90
  mov ecx,eax
  call BBTAG.exe+4DED00
  test eax,eax
  db 74 24 // JE
  mov esi,[edi+30]
  call BBTAG.exe+4E2F90
  cmp dword ptr [eax+esi*4+0001B5E4],01
  db 74 29 // JE
  mov esi,[edi+30]
  call BBTAG.exe+4E2F90
  cmp dword ptr [eax+esi*4+0001B5E4],03
  db EB B8 // JMP
  cmp dword ptr [edi+00008F98],00
  db 75 0E // JNE
  cmp dword ptr [edi+00008F90],07
  db 7E 05 // JLE
  pop edi
  xor eax,eax
  pop esi
  ret
  pop edi
  mov eax,00000001
  pop esi
  ret

OverDrive_Burst_Meter_Stock_Check:
  push ebp
  mov ebp,esp
  push esi
  mov esi,ecx
  push edi
  lea ecx,[esi+000001FC]
  call BBTAG.exe+5EFA30
  cmp dword ptr [eax+000004B0],03
  db 7C 11 // JL
  test byte ptr [esi+00000268],04
  db 74 08 // JE
overDriveBurstMeterStockCheck_cancel:
  pop edi
  xor eax,eax
  pop esi
  pop ebp
  ret 0004
  mov eax,[esi+00000268]
  test eax,00002000
  jne overDriveBurstMeterStockCheck_cancel
  cmp dword ptr [esi+0000083C],00
  db 74 04 // JE
  test al,04
  jne overDriveBurstMeterStockCheck_cancel
  test byte ptr [esi+0000026C],20
  jne overDriveBurstMeterStockCheck_cancel
  lea ecx,[esi+000001FC]
  call BBTAG.exe+5EFA30
  lea ecx,[eax+000001F4]
  call BBTAG.exe+5EFA30
  mov ecx,eax
  call BBTAG.exe+358420
  test eax,eax
  db 75 21 // JNE
