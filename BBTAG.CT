aobscanmodule(Enabled_Collision_After_Death,$process,83 B8 E0 8A 02 00 00 8B)
alloc(newmem,$1000)

label(code)
label(return)

newmem:

code:
  push ecx
  mov ecx,eax
  cmp dword ptr [eax+00028AE0],00
  setne al
  movzx eax,al
  test eax,eax
  je code_end // Jump if Alive
  push eax
  call BBTAG.exe+3649F0 // Get Partner
  cmp dword ptr [eax+00028AE0],00
  setne al
  movzx eax,al
  pop ecx
  xor eax,ecx
  test eax,eax
  jne code_end // Jump if only one is Alive
  mov esi,00000001 // If both are Dead, EAX has been inverted and ESI will be forced.
code_end:
  xor ecx,ecx
  cmp eax,ecx
  pop ecx
  jmp return

Enabled_Collision_After_Death:
  jmp newmem
  nop 2
return:
registersymbol(Enabled_Collision_After_Death)

