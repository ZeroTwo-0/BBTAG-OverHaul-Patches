                  <Options moManualExpandCollapse="1" moDeactivateChildrenAsWell="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript Async="1">{$lua}
[ENABLE]
if syntaxcheck or
   core == nil or
   core.static == nil or
   core.static.vTables == nil or
   core.static.vTables.charBase == nil or
   core.static.vTables.charBase.functions == nil then MemoryRecordTools.Disable(memrec); return end
if not core or not core.script or not core.script.debug then core.script.debug = {} end
if not core.script.debug.printBBScriptCmdVirtFuncAddr then core.script.debug.printBBScriptCmdVirtFuncAddr = {} end
if core.script.debug.printBBScriptCmdVirtFuncAddr.cachedTbl and #core.script.debug.printBBScriptCmdVirtFuncAddr.cachedTbl == 0x0 then core.script.debug.printBBScriptCmdVirtFuncAddr.cachedTbl = nil end
synchronize(function()
    CreateStringInputForm("searchCommandID", "Command ID", "Enter Command ID:", true, false, nil, nil, function(val, name)
        formVariables[name] = val
    end)
end)
local input = formVariables.searchCommandID

local useCache = true
local jmpTbl = {}
local addr = 0x0
if (useCache and not core.script.debug.printBBScriptCmdVirtFuncAddr.cachedTbl) or not useCache then
    print("Scanning Switch Case Function...")
    local bbscriptCmdFuncAddr = AoBTools.ScanAoBTable({
        {"8B * * * * * 85 * 74 * * E8 * * * * 83 * * 75", 0xC, {AoBTools.AoBPointerType.NearAddress}},
        {"E8 * * * * 8B * 3B * 75", 0x1, {AoBTools.AoBPointerType.NearAddress}},
        {"74 * 83 * * 75 * 8B * * * * * F6", 0x6, {AoBTools.AoBPointerType.CloseJump}},
        {"83 * * 75 * E8", 0x4, {AoBTools.AoBPointerType.CloseJump}},
        {"E8 * * * *", 0x1, {AoBTools.AoBPointerType.NearAddress}}
    }, core.static.vTables.charBase.functions[19], core.game.moduleEndAddress)

    local bbscriptCmdFuncEndAddr = AoBTools.ScanAoBTable({
        {"83 * * 0F 87 * * * * FF", 0x5, {AoBTools.AoBPointerType.FarJump}},
        {"C2 04 00", 0x3}
    }, bbscriptCmdFuncAddr, core.game.moduleEndAddress)
    local addr = AoBTools.ScanAoBTable({
        {"0F 84 * * * * 83 * * 0F 87 * * * * FF * * * * * *", 0x8}
    }, bbscriptCmdFuncAddr, bbscriptCmdFuncEndAddr)
    table.insert(jmpTbl, {0x0, readByte(addr), readInteger(addr+0xA), nil, true, addr &lt;= core.game.moduleEndAddress})
    addr = bbscriptCmdFuncAddr
    repeat
        local jeCheckAddr = AoBTools.ScanAoBTable({
            {"81 * * * * * 0F 87 * * * * 0F 84 * * * *", 0x2}
        }, addr, bbscriptCmdFuncEndAddr)
        local jeHalfShortCheckAddr = AoBTools.ScanAoBTable({
            {"81 * * * * * 0F 87 * * * * 74 *", 0x2}
        }, addr, bbscriptCmdFuncEndAddr)
        local jeShortCheckAddr = AoBTools.ScanAoBTable({
            {"81 * * * * * 77 * 74 *", 0x2}
        }, addr, bbscriptCmdFuncEndAddr)
        local jneCheckAddr = AoBTools.ScanAoBTable({
            {"81 * * * * * 0F 85 * * * *", 0x2}
        }, addr, bbscriptCmdFuncEndAddr)
        local dynMultiTblJmpAddr = AoBTools.ScanAoBTable({
            {"81 * * * * * 81 * * * * * 0F 87 * * * * 0F * * * * * * FF * * * * * *", 0x2}
        }, addr, bbscriptCmdFuncEndAddr)
        local dynJmpAddr = AoBTools.ScanAoBTable({
            {"81 * * * * * 81 * * * * * 0F 87 * * * * FF * * * * * *", 0x2}
        }, addr, bbscriptCmdFuncEndAddr)
        local dynMultiTblJmpShortAddr = AoBTools.ScanAoBTable({
            {"81 * * * * * 83 * * 0F 87 * * * * 0F * * * * * * FF * * * * * *", 0x2}
        }, addr, bbscriptCmdFuncEndAddr)
        local dynJmpShortAddr = AoBTools.ScanAoBTable({
            {"81 * * * * * 83 * * 0F 87 * * * * FF * * * * * *", 0x2}
        }, addr, bbscriptCmdFuncEndAddr)
        addr = bbscriptCmdFuncEndAddr
        local tbl = {jeCheckAddr, jeHalfShortCheckAddr, jeShortCheckAddr, jneCheckAddr, dynMultiTblJmpAddr, dynJmpAddr, dynMultiTblJmpShortAddr, dynJmpShortAddr}
        for _,a in ipairs(tbl) do
            if a and a &gt; 0x0 then
                addr = addr &lt; a and addr or a
            end
        end
        if jeCheckAddr == addr then
            table.insert(jmpTbl, {readIntegerSigned(addr), 0x0, addr+0xC+readIntegerSigned(addr+0xC)+0x4, nil, false, addr &lt;= core.game.moduleEndAddress})
        elseif jeHalfShortCheckAddr == addr then
            table.insert(jmpTbl, {readIntegerSigned(addr), 0x0, addr+0xB+readByteSigned(addr+0xB)+0x1, nil, false, addr &lt;= core.game.moduleEndAddress})
        elseif jeShortCheckAddr == addr then
            table.insert(jmpTbl, {readIntegerSigned(addr), 0x0, addr+0x7+readByteSigned(addr+0x7)+0x1, nil, false, addr &lt;= core.game.moduleEndAddress})
        elseif jneCheckAddr == addr then
            table.insert(jmpTbl, {readIntegerSigned(addr), 0x0, addr+0xA, nil, false, addr &lt;= core.game.moduleEndAddress})
        elseif dynMultiTblJmpAddr == addr then
            table.insert(jmpTbl, {readIntegerSigned(addr), readInteger(addr+0x6), readInteger(addr+0x13), readInteger(addr+0x1A), true, addr &lt;= core.game.moduleEndAddress})
        elseif dynJmpAddr == addr then
            table.insert(jmpTbl, {readIntegerSigned(addr), readInteger(addr+0x6), readInteger(addr+0x13), nil, true, addr &lt;= core.game.moduleEndAddress})
        elseif dynMultiTblJmpShortAddr == addr then
            table.insert(jmpTbl, {readIntegerSigned(addr), readByte(addr+0x6), readInteger(addr+0x10), readInteger(addr+0x17), true, addr &lt;= core.game.moduleEndAddress})
        elseif dynJmpShortAddr == addr then
            table.insert(jmpTbl, {readIntegerSigned(addr), readByte(addr+0x6), readInteger(addr+0x10), nil, true, addr &lt;= core.game.moduleEndAddress})
        else
            addr = 0x0
        end
    until (addr == 0x0 or addr &gt;= bbscriptCmdFuncEndAddr)
    local extendedAddr = getAddressSafe("BBScript_Command_Extension")
    if extendedAddr ~= nil and extendedAddr &gt; 0x0 then
        addr = AoBTools.ScanAoBTable({
            {"E9 * * * *", 0x1, {AoBTools.AoBPointerType.NearAddress}}
        }, extendedAddr, extendedAddr+0x5)
        local dynJmpAddr = AoBTools.ScanAoBTable({
            {"81 * * * * * 81 * * * * * 0F 87 * * * * FF * * * * * *", 0x2}
        }, addr, addr+10000)
        table.insert(jmpTbl, {readIntegerSigned(dynJmpAddr), readInteger(dynJmpAddr+0x6), readInteger(dynJmpAddr+0x13), nil, true, dynJmpAddr &lt;= core.game.moduleEndAddress})
        addr = AoBTools.ScanAoBTable({
           {"81 * * * * * E9", 0x2}
        }, addr, addr+10000)
        local num = readIntegerSigned(addr)
        addr = addr+0x5+readIntegerSigned(addr+0x5)+0x4
        dynJmpAddr = AoBTools.ScanAoBTable({
            {"83 * * 0F 87 * * * * FF * * * * * *", 0x2}
        }, addr, bbscriptCmdFuncEndAddr)
        table.insert(jmpTbl, {num, readByte(dynJmpAddr), readInteger(dynJmpAddr+0xA), nil, true, dynJmpAddr &lt;= core.game.moduleEndAddress})
    end
    local function compare(a,b)
      local n1 = a[0x1]
      local n2 = b[0x1]
      if n1 &lt; 0x0 then n1 = n1 * -0x1 end
      if n2 &lt; 0x0 then n2 = n2 * -0x1 end
      n1 = n1 + a[0x2]
      n2 = n2 + b[0x2]
      return n1 &lt; n2
    end
    table.sort(jmpTbl, compare)
end

if useCache then
    if not core.script.debug.printBBScriptCmdVirtFuncAddr.cachedTbl then
        core.script.debug.printBBScriptCmdVirtFuncAddr.cachedTbl = {}
        print("Building reusable cache...")
        for _,tbl in ipairs(jmpTbl) do
            for i=0x0,tbl[0x2] do
                local tmpAddr = nil
                if not tbl[0x5]then
                    tmpAddr = tbl[0x3]
                elseif not tbl[0x4] then
                    tmpAddr = readInteger(tbl[0x3]+(i*0x4))
                else
                    local n = readByte(tbl[0x3]+i)
                    tmpAddr = readInteger(tbl[0x4]+(n*0x4))
                end
                local switchCaseAddr = tmpAddr
                if tmpAddr &lt;= core.game.moduleEndAddress then
                    local endCaseAddr = AoBTools.ScanAoBTable({
                        {"C2 04 00", 0x3}
                    }, tmpAddr, bbscriptCmdFuncEndAddr)
                    local off = AoBTools.ScanAoBTables({
                        {{"FF * * * * * 33 C0", 0x2, {AoBTools.AoBPointerType.Offset, 0x4, true}}},
                        {{"FF * * 33 C0", 0x2, {AoBTools.AoBPointerType.Offset, 0x1, true}}}
                    }, tmpAddr, endCaseAddr)
                    if off ~= nil and off ~= 0x0 then
                        tmpAddr = readInteger(core.static.vTables.charBase.address + off)
                    end
                end
                local startNum = tbl[0x1]
                if startNum &lt; 0x0 then startNum = startNum * -0x1 end
                table.insert(core.script.debug.printBBScriptCmdVirtFuncAddr.cachedTbl, {startNum+i, tmpAddr, switchCaseAddr, tbl[0x6]})
            end
        end
    end
    for _,tbl in ipairs(core.script.debug.printBBScriptCmdVirtFuncAddr.cachedTbl) do
        if input == tbl[0x1] then
            print(NumberToHexString(tbl[0x2]))
            break
        end
    end
else
    for _,tbl in ipairs(jmpTbl) do
        local startNum = tbl[0x1]
        if startNum &lt; 0x0 then startNum = startNum * -0x1 end
        if input &lt;= startNum+tbl[0x2] then
            local num = input - startNum
            if not tbl[0x5]then
                addr = tbl[0x3]
            elseif not tbl[0x4] then
                addr = readInteger(tbl[0x3]+(num*0x4))
            else
                local n = readByte(tbl[0x3]+num)
                addr = readInteger(tbl[0x4]+(n*0x4))
            end
            break
        end
    end
    local off = AoBTools.ScanAoBTable({
        {"FF * * * * * 33 C0", 0x2, {AoBTools.AoBPointerType.Offset, 0x4, true}}
    }, addr, bbscriptCmdFuncEndAddr)
    addr = readInteger(core.static.vTables.charBase.address + off)

    print(NumberToHexString(addr))
end
formVariables.searchCommandID = nil
MemoryRecordTools.Disable(memrec)
[DISABLE]
{$asm}
</AssemblerScript>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>21570</ID>
                      <Description>"Clear Cache"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck then return end
if core and core.script and core.script.debug and core.script.debug.printBBScriptCmdVirtFuncAddr then
    core.script.debug.printBBScriptCmdVirtFuncAddr.cachedTbl = nil
    print("Cache Cleared.")
end
MemoryRecordTools.Disable(memrec)
[DISABLE]
{$asm}
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>21572</ID>
                      <Description>"Save Cache"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck or
   core == nil or
   core.static == nil or
   core.static.vTables == nil or
   core.static.vTables.charBase == nil or
   core.static.vTables.charBase.functions == nil or
   core.script == nil or
   core.script.debug == nil or
   core.script.debug.printBBScriptCmdVirtFuncAddr == nil or
   core.script.debug.printBBScriptCmdVirtFuncAddr.cachedTbl == nil then MemoryRecordTools.Disable(memrec); return end

local saveFileDialog = function(fileName, text)
    local saveDialog = createSaveDialog(self)
    saveDialog.Title = "Save file as..."
    saveDialog.FileName = fileName
    saveDialog.DefaultExt = ".csv"
    saveDialog.Filter = "CSV (Comma delimited)|*" .. saveDialog.DefaultExt
    if saveDialog.execute() then
        local SaveLocation = saveDialog.FileName
        local f, e = io.open(SaveLocation, "w+")
        f:write(text, "\n")
        f:close()
    end
end
local text = ""
for _,tbl in pairs (core.script.debug.printBBScriptCmdVirtFuncAddr.cachedTbl) do
    if tbl[0x4] then
        text = text..tbl[0x1]
               ..", 0x"..NumberToHexString(tbl[0x2])
               ..", 0x"..NumberToHexString(tbl[0x3])
               ..", 0x"..NumberToHexString(tbl[0x2]-core.game.moduleAddress)
               ..", 0x"..NumberToHexString(tbl[0x3]-core.game.moduleAddress).."\n"
    end
end
saveFileDialog("BBScript Command Address Cache", text)
print("Saved Cached.")
MemoryRecordTools.Disable(memrec)
[DISABLE]
{$asm}
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>21571</ID>
                      <Description>"Load Cache"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck or
   core == nil or
   core.static == nil or
   core.static.vTables == nil or
   core.static.vTables.charBase == nil or
   core.static.vTables.charBase.functions == nil or
   core.script == nil then MemoryRecordTools.Disable(memrec); return end
if not core or not core.script or not core.script.debug then core.script.debug = {} end
if not core.script.debug.printBBScriptCmdVirtFuncAddr then core.script.debug.printBBScriptCmdVirtFuncAddr = {} end

local moddedCached = {}
if core.script.debug.printBBScriptCmdVirtFuncAddr.cachedTbl then
    for _,tbl in ipairs(core.script.debug.printBBScriptCmdVirtFuncAddr.cachedTbl) do
        if not tbl[0x4] then table.insert(moddedCached, tbl) end
    end
end
local openFileDialog = function(fileName)
    local openDialog = createSaveDialog(self)
    openDialog.Title = "Open file ..."
    openDialog.FileName = fileName
    openDialog.DefaultExt = ".csv"
    openDialog.Filter = "CSV (Comma delimited)|*" .. openDialog.DefaultExt
    if openDialog.execute() then
        local FileLocation = openDialog.FileName
        local f = io.open(FileLocation, "rb")
        if f then f:close() end
        if f ~= nil then return FileLocation else return nil end
    end
    return nil
end
local filePath = openFileDialog("BBScript Command Address Cache")
if filePath ~= nil then
    local cachedTbl = {}
    for line in io.lines(filePath) do
        local fields = {}
        for field in string.gmatch(line, '([^,]+)') do
            table.insert(fields, field)
        end
        if fields[0x1] ~= nil and fields[0x1] ~= "" then
            if fields[0x2] ~= nil and fields[0x2] ~= "" then
                fields[0x2] = tonumber(string.match(fields[0x2], "0x(.*)"), 0x10)
            end
            if fields[0x3] ~= nil and fields[0x3] ~= "" then
                fields[0x3] = tonumber(string.match(fields[0x3], "0x(.*)"), 0x10)
            end
            table.insert(cachedTbl, {tonumber(fields[0x1]), fields[0x2], fields[0x3]})
        end
        core.script.debug.printBBScriptCmdVirtFuncAddr.cachedTbl = cachedTbl
        for _,tbl in ipairs(moddedCached) do
            table.insert(core.script.debug.printBBScriptCmdVirtFuncAddr.cachedTbl, tbl)
        end
    end
    print("Loaded Cached.")
end
MemoryRecordTools.Disable(memrec)
[DISABLE]
{$asm}
</AssemblerScript>
                    </CheatEntry>
                  </CheatEntries>
                </CheatEntry>
