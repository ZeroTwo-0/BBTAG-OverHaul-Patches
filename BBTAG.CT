        <CheatEntry>
          <ID>20684</ID>
          <Description>"Scripts"</Description>
          <Options moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript Async="1">{$lua}
[ENABLE]
if GeneralTools.WaitForCondition(function()
    return (core ~= nil and
            core.game ~= nil and
            core.static ~= nil and
            core.script ~= nil)
        end, 60, 3000) then
    return
else
    error("Wait condition failed.")
end
[DISABLE]
{$asm}
</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>21538</ID>
              <Description>"BBScript Modifications"</Description>
              <Options moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>21539</ID>
                  <Description>"SLOT Get &amp; Set Override"</Description>
                  <Options moActivateChildrenAsWell="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript Async="1">[ENABLE]
{$lua}
if syntaxcheck then return end
if not GeneralTools.WaitForCondition(function()
    return (core.static ~= nil and
            core.static.gamedata ~= nil and
            core.static.gamedata.stageCameraSettings ~= nil and
            not isNilOrZero(core.static.gamedata.stageCameraSettings.offset) and
            not isNilOrZero(core.static.gamedata.BGManagerSettings.offset))
        end, 60, 3000) then
    error("Wait condition failed.")
end
{$asm}

