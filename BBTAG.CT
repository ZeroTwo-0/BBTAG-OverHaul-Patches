  pop eax
  push DC
  jmp Barrier_Guard_State_Effect_Input+5
barrierEffectInputCheckMBTL:
  pop ecx
  pop eax
  push 00
  jmp Barrier_Guard_State_Effect_Input+5

barrierEffect:
  mov ecx,ebx
  call func_BarrierCheckInput
  test eax,eax
  je barrierEffect_reject
  push 0000FFFF
  sub esp,20
  mov ecx,esp
  push BBTAG.exe+774EE4
  call BBTAG.exe+13540
  mov ecx,edi
  call dword ptr [esi+00000568]
  lea ecx,[edi+000001FC]
  call BBTAG.exe+5EFA30
  cmp dword ptr [eax+000001E8],00
  db 7E 04 // JLE
  test ebx,ebx
  db 75 09 // JNE
  push -64
  mov ecx,edi
  call Modify_Barrier
  pop edi
  pop esi
  mov esp,ebp
  pop ebp
  ret
barrierEffect_reject:
  push 66
  sub esp,20
  jmp barrierEffect_return

barrierGuardState:
