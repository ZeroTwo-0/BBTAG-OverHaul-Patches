                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript Async="1">[ENABLE]
{$lua}
if syntaxcheck then return end
autoAssemble([[
alloc(Announcer_Char_Pointers_Override_Memory,$10000,BBTAG.exe)
registersymbol(Announcer_Char_Pointers_Override_Memory)
]])
local addr = AoBTools.ScanAoBTable({ {"E8 * * * * 39 * * * * * B8 * * * * 70 * 8B", 0x15} }, core.game.moduleAddress, core.game.moduleEndAddress)
local addr2 = AoBTools.ScanAoBTable({ {"E8 * * * * 39 * * * * * B8 * * * * 70 * 8B", 0x15} }, addr, core.game.moduleEndAddress)
core.script.announcerPointerOverride = {}
core.script.announcerPointerOverride.firstResultIsCharSelNames = string.sub(readString(readPointer(readPointer(addr)), 0xC, false), 0x0, 0x3) == "ns2"
core.script.announcerPointerOverride.CharSelNamesAddr = core.script.announcerPointerOverride.firstResultIsCharSelNames and addr or addr2
core.script.announcerPointerOverride.WinNamesAddr = core.script.announcerPointerOverride.firstResultIsCharSelNames and addr2 or addr
core.script.announcerPointerOverride.CharSelNamesOrigBytes = readBytes(core.script.announcerPointerOverride.CharSelNamesAddr, 0x4, true)
core.script.announcerPointerOverride.WinNamesOrigBytes = readBytes(core.script.announcerPointerOverride.WinNamesAddr, 0x4, true)
local memAddr = getAddressSafe("Announcer_Char_Pointers_Override_Memory")
for i=0x1,0x35 do
    local addr = memAddr+((i-0x1)*0x8)
    writePointer(addr, readPointer(readPointer(core.script.announcerPointerOverride.CharSelNamesAddr)+((i-0x1)*0x4)))
    writePointer(addr+0x4, readPointer(readPointer(core.script.announcerPointerOverride.WinNamesAddr)+((i-0x1)*0x4)))
end
writeByte(core.script.announcerPointerOverride.CharSelNamesAddr-0x1, 0xF5)
writeInteger(core.script.announcerPointerOverride.CharSelNamesAddr, memAddr)
writeByte(core.script.announcerPointerOverride.WinNamesAddr-0x1, 0xF5)
writeInteger(core.script.announcerPointerOverride.WinNamesAddr, memAddr+0x4)
{$asm}
[DISABLE]

