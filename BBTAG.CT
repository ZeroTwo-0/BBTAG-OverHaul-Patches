command_40023: //grabsetCBASE
command_grabsetCBASE:
  mov edx,[ebp+08] // Get Arguments



command_grabsetCBASE_settergetter:
  mov esi,[edx]   // Arg 1 get/set
  mov ecx,ebx
  push ebx
  test esi,esi
  je command_grabsetCBASE_getter


  mov esi,[edx+8]   // Arg 3 conversion type
  cmp esi,2
  je command_grabsetCBASE_setter_floattoint
  mov ebx,[edx+4] // Arg 2 offset
  lea ebx, [ebx*4]
  add, ebx,ecx
  mov eax,[ebx]
  jmp command_grabsetCBASE_setter
command_grabsetCBASE_setter_floattoint:
  mov ebx,[edx+4] // Arg 2 offset
  lea ebx, [ebx*4]
  add, ebx,ecx
  mov eax,[ebx]


  movd xmm0, eax

  mov eax, 100
  cvtsi2ss xmm1, eax
  mulss xmm0, xmm1

  movd eax, xmm0


  jmp command_grabsetCBASE_setter

command_grabsetCBASE_setter:
  push eax
  mov esi,[edx+C]   // Arg 4 slot #
  sub esp,08
  mov eax,esp
  mov [eax],00000002
  mov [eax+04],esi
  call BBTAG.exe+367CC0
  jmp command_grabsetCBASE_end


command_grabsetCBASE_getter:
  mov esi,[edx+C]   // Arg 4 slot #
  sub esp,08
  mov eax,esp
  mov [eax],00000002
  mov [eax+04],esi
  call BBTAG.exe+3634B0
  mov esi,[edx+8]   // Arg 3 conversion type
  cmp esi,1
  je command_grabsetCBASE_getter_inttofloat
  mov ebx,[edx+4] // Arg 2 offset
  lea ebx, [ebx*4]
  add, ebx,ecx
  mov [ebx],eax
  jmp command_grabsetCBASE_end

command_grabsetCBASE_getter_inttofloat:
  mov ebx,[edx+4] // Arg 2 offset
  lea ebx, [ebx*4]
  add, ebx,ecx

  mov eax,[ebx]

  cvtsi2ss xmm0, eax

  mov eax, 100
  cvtsi2ss xmm1, eax
  divss xmm0, xmm1

  movd eax, xmm0

  mov [ebx],eax
  jmp command_grabsetCBASE_end

command_grabsetCBASE_end:
  pop ebx
  jmp command_end

command_end:
  pop edi
  pop esi
  pop ebx
  pop ebp
  ret 0004

func_getCharExtMem:
  push ebp
  mov ebp,esp
  mov eax,[ebp+08]
  mov eax,[eax+0C]
  mov eax,[CharBase_Extended_Memory_Pointers+eax*4]
  pop ebp
  ret 0004


bbscriptCommandExtension_pointers:
{$lua}
if syntaxcheck then return end

local newCmdAmnt = 0x18

local addrstr = NumberToHexString(core.script.bbscriptCommandExtension.JAAddress)..'\n'
local s='dd '
local tbl = {}
for i=0x1,core.script.bbscriptCommandExtension.AdditionalCases do
  table.insert(tbl, s..addrstr)
end
for i=0x1,newCmdAmnt do
    tbl[i] = s..'command_'..(40000 + i-0x1)..'\n'
end
s = ''
for i,str in ipairs(tbl) do
    s=s..str
end
return s
{$asm}
bbscriptCommandExtension_parseTable:
{$lua}
if syntaxcheck then return end
local tbl = {}
local addr = core.script.bbscriptCommandExtension.OrigParseTableAddr
local origSize = core.script.bbscriptCommandExtension.OrigSizeVal
for i=0x0,core.script.bbscriptCommandExtension.OrigSizeVal do
  local off = i*0x8
  table.insert(tbl, {readInteger(addr+off), readInteger(addr+off+0x4)})
end
for i=origSize,origSize+core.script.bbscriptCommandExtension.AdditionalCases-0x1 do
  table.insert(tbl, {0xFFFFFFFF, 0xFFFFFFFF})
end

tbl[origSize+0x1] = {0x00009C40, 0x8} --- cmd 40000
tbl[origSize+0x2] = {0x00009C41, 0x8} --- cmd 40001
tbl[origSize+0x3] = {0x00009C42, 0x1C} --- cmd 40002
tbl[origSize+0x4] = {0x00009C43, 0xC} --- cmd 40003
tbl[origSize+0x5] = {0x00009C44, 0x14} --- cmd 40004
tbl[origSize+0x6] = {0x00009C45, 0x8} --- cmd 40005
tbl[origSize+0x7] = {0x00009C46, 0x4} --- cmd 40006
tbl[origSize+0x8] = {0x00009C47, 0x28} --- cmd 40007
tbl[origSize+0x9] = {0x00009C48, 0x28} --- cmd 40008
tbl[origSize+0xa] = {0x00009C49, 0x28} --- cmd 40009
tbl[origSize+0xb] = {0x00009C4a, 0x8} --- cmd 40010
tbl[origSize+0xc] = {0x00009C4b, 0x28} --- cmd 40011
tbl[origSize+0xd] = {0x00009C4c, 0x28} --- cmd 40012
tbl[origSize+0xe] = {0x00009C4d, 0xC} --- cmd 40013
tbl[origSize+0xf] = {0x00009C4e, 0x8} --- cmd 40014
tbl[origSize+0x10] = {0x00009C4f, 0xC} --- cmd 40015
tbl[origSize+0x11] = {0x00009C50, 0x8} --- cmd 40016
tbl[origSize+0x12] = {0x00009C51, 0x28} --- cmd 40017
tbl[origSize+0x13] = {0x00009C52, 0x14} --- cmd 40018
tbl[origSize+0x14] = {0x00009C53, 0x8} --- cmd 40019
tbl[origSize+0x15] = {0x00009C54, 0x8} --- cmd 40020
tbl[origSize+0x16] = {0x00009C55, 0x8} --- cmd 40021
tbl[origSize+0x17] = {0x00009C56, 0x8} --- cmd 40022
tbl[origSize+0x18] = {0x00009C57, 0x24} --- cmd 40023

local s=''
for i,t in ipairs(tbl) do
    s=s..'dd '..NumberToHexString(t[0x1])..'\n'
    s=s..'dd '..NumberToHexString(t[0x2])..'\n'
end
return s
{$asm}

core.script.bbscriptCommandExtension.Address:
  jmp bbscriptCommandExtension
  nop
bbscriptCommandExtension_return:

