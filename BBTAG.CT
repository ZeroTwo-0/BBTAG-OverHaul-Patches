  mov eax,00000064
  jmp barrierGuardAntiAir_return

barrierGuardBarrierDamage:
  mov ecx,edi
  call BBTAG.exe+3B74A0
  test eax,eax
  je barrierGuardBarrierDamage_end
  mov eax,[edi+000007D0]
  mov ecx,000003E8
  cmp eax,ecx
  cmovg eax,ecx
  mov ecx,edi
  mov [ebp-00000094],eax
  call BBTAG.exe+3583F0
  test eax,eax
  mov eax,51EB851F
  je barrierGuardBarrierDamage_je
  mov ecx,[ebp-00000094]
  neg ecx
  shl ecx,02
  sub ecx,[ebp-00000094]
  shl ecx,02
  imul ecx
  jmp barrierGuardBarrierDamage_jmp
barrierGuardBarrierDamage_je:
  mov edx,[ebp-00000094]
  imul edx,edx,-32
  imul edx
barrierGuardBarrierDamage_jmp:
  sar edx,05
  mov eax,edx
