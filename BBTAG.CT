{$asm}
</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>21574</ID>
                  <Description>"Shared Alloc"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript Async="1">{$lua}
if syntaxcheck then return end
[ENABLE]
core.rebuild.sharedMemory = {}
local extendSection = nil
for _,sec in ipairs(core.game.peFileInfo.Header.SectionTable) do
    if sec.Name == ".extend" then
        extendSection = sec
        break;
    end
end
core.rebuild.sharedMemory.address = extendSection and core.game.moduleAddress+extendSection.VirtualAddress or allocateMemory(0x100000, core.game.moduleEndAddress)
core.rebuild.sharedMemory.reserves = {}

core.rebuild.sharedMemory.reserve = function(size, offset)
    if not offset then
        local endingReserve = nil
        for _,r in ipairs(core.rebuild.sharedMemory.reserves) do
            if not endingReserve or r &gt; endingReserve.Offset then
                endingReserve = r
            end
        end
        if not endingReserve then
            offset = 0x0
        else
            offset = endingReserve.Offset + endingReserve.Size
        end
    end
    local reserve = {}
    local id = 0x0
    local exists = false
    repeat
        exists = false
        for _,r in ipairs(core.rebuild.sharedMemory.reserves) do
            if r.ID == id then
                exists = true
                id = id + 0x1
                break
            end
        end
    until(not exists)
    reserve.ID = id
    reserve.Address = core.rebuild.sharedMemory.address + offset
    reserve.Size = size
    reserve.Offset = offset
    table.insert(core.rebuild.sharedMemory.reserves, reserve)
    return reserve
end

core.rebuild.sharedMemory.getSize = function()
    local endingReserve = nil
    for _,r in ipairs(core.rebuild.sharedMemory.reserves) do
        if not endingReserve or r.Offset &gt; endingReserve.Offset then
            endingReserve = r
        end
    end
    if not endingReserve then return 0x0 end
    return endingReserve.Offset + endingReserve.Size
end

[DISABLE]

{$asm}

</AssemblerScript>
