                  <CheatEntries>
                    <CheatEntry>
                      <ID>21164</ID>
                      <Description>"System Heat Change &amp; Conditions"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript Async="1">[ENABLE]
{$lua}
if syntaxcheck then return end

local result = AoBTools.ScanAoBTable({
    {"6A 01 79 * 68 * * * * EB * 68 * * * * E8", 0xB}
}, core.game.moduleAddress, core.game.moduleEndAddress)
core.script.systemHeatChangeCondValues = {}
core.script.systemHeatChangeCondValues.OrigPushBytes = readBytes(result+0x1, 0x4, true)
registerSymbol("systemHeatChangeCondOrigPush", readIntegerSigned(result+0x1), true)
registerSymbol("System_Heat_Change_Condition", result, true)

local cond = 0x2002
local condSwitchCase = cond - 0x2001
result = AoBTools.ScanAoBTable({
    {"E8 * * * * 85 C0", 0x1, {AoBTools.AoBPointerType.NearAddress}},
    {"8B 0C 8A 3B 4D *"}
},  readPointer(AoBTools.ScanAoBTable({
    {"81 * 00 30 00 00 0F 8F * * * * 0F 84"},
    {"7F * 74", 0x1, {AoBTools.AoBPointerType.CloseJump}},
    {"0F 87 * * * * FF", 0x9, {AoBTools.AoBPointerType.FarAddress}}
}, core.game.moduleAddress, core.game.moduleEndAddress) + condSwitchCase * 0x4), core.game.moduleEndAddress)
core.script.systemHeatChangeCondValues.OrigStackOff = readByteSigned(result+0x5)
registerSymbol("systemHeatChangeCondOrigStackOff", core.script.systemHeatChangeCondValues.OrigStackOff, true)
registerSymbol("System_Heat_Check_Amount", result, true)

result = AoBTools.ScanAoBTable({
    {"E8 * * * * * C0 75 * 83 * * * * * FF 75", 0x10}
}, core.game.moduleAddress, core.game.moduleEndAddress)
registerSymbol("System_Heat_Change_Condition_Remove_Cooldown_Lock", result, true)
{$asm}
alloc(newmem,$1000)

label(systemHeatChangeCond)
label(systemHeatChangeCond_end)
label(systemHeatChangeCond_return)

label(systemHeatChangeCondAmount)
label(systemHeatChangeCondAmount_return)

newmem:

systemHeatChangeCond:
  push ecx
  push esi
  xor esi,esi
  mov ecx,ebx
  call BBTAG.exe+3B8BE0
  mov esi,eax
  mov eax,systemHeatChangeCondOrigPush
  test esi,esi
  jne systemHeatChangeCond_end
  shl eax,01
systemHeatChangeCond_end:
  pop esi
  pop ecx
  push eax
  jmp systemHeatChangeCond_return

systemHeatChangeCondAmount:
  push ecx
  mov ecx,[esi+000241E0]
  test ecx,ecx
  pop ecx
  jne systemHeatChangeCondAmount_Mugen
  mov ecx,[edx+ecx*4]
  // Subtract Player Char Heat Reserve
  push ecx
  mov ecx,esi
  call systemHeatChangeCondAmount_GetHeatReserve
  pop ecx
  sub ecx,eax
  // Subtract Other Player Char Heat Reserve
  push ecx
  mov ecx,esi
  call BBTAG.exe+3649F0
  mov ecx,eax
  call systemHeatChangeCondAmount_GetHeatReserve
  pop ecx
  sub ecx,eax
  xor eax,eax
  cmp ecx,[ebp+systemHeatChangeCondOrigStackOff]
  jmp systemHeatChangeCondAmount_return
systemHeatChangeCondAmount_Mugen:
  cmp ecx,ecx
  jmp systemHeatChangeCondAmount_return

systemHeatChangeCondAmount_GetHeatReserve:
  sub esp,08
  mov eax,esp
  mov [eax],00000002
  mov [eax+04],000000D6
  call BBTAG.exe+3634B0
  ret

System_Heat_Change_Condition:
  jmp systemHeatChangeCond
systemHeatChangeCond_return:

System_Heat_Check_Amount:
  jmp systemHeatChangeCondAmount
  nop
systemHeatChangeCondAmount_return:

System_Heat_Change_Condition_Remove_Cooldown_Lock:
  db EB

unregisterSymbol(systemHeatChangeCondOrigPush)
unregisterSymbol(systemHeatChangeCondOrigStackOff)

[DISABLE]

System_Heat_Change_Condition:
  db 68
{$lua}
if syntaxcheck then return end
writeBytes(getAddressSafe("System_Heat_Change_Condition")+0x1, core.script.systemHeatChangeCondValues.OrigPushBytes)
{$asm}
unregistersymbol(System_Heat_Change_Condition)

System_Heat_Check_Amount:
  db 8B 0C 8A 3B 4D
{$lua}
if syntaxcheck then return end
writeByte(getAddressSafe("System_Heat_Check_Amount")+0x5, core.script.systemHeatChangeCondValues.OrigStackOff)
core.script.systemHeatChangeCondValues = nil
{$asm}
unregistersymbol(System_Heat_Check_Amount)

System_Heat_Change_Condition_Remove_Cooldown_Lock:
  db 75
unregistersymbol(System_Heat_Change_Condition_Remove_Cooldown_Lock)
dealloc(newmem)
