local addressList = getAddressList()
local dropDownListsMemRec = addressList.getMemoryRecordByDescription('#Drop Down Lists')
local mr = addressList.createMemoryRecord()
mr.Description = "#BGM"
mr.IsGroupHeader = true
mr.Parent = dropDownListsMemRec
mr.DontSave = true
mr.DropDownList.Text = dropDownList
mr.DropDownReadOnly = false
mr.DropDownDescriptionOnly = false
mr.DisplayAsDropDownListItem = true
end)
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
synchronize(function()
local addressList = getAddressList()
local symbolsMemRec = addressList.getMemoryRecordByDescription('#BGM')
if symbolsMemRec~=nil then memoryrecord_delete(symbolsMemRec) end
end)
core.struct.songs = nil
{$asm}
</AssemblerScript>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>21766</ID>
                      <Description>"Generate &amp; Save Localize Data"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local saveFileDialog = function(fileName, text)
    local saveDialog = createSaveDialog(self)
    saveDialog.Title = "Save files as..."
    saveDialog.FileName = fileName
    saveDialog.DefaultExt = ".txt"
    saveDialog.Filter = "Text Documents|*" .. saveDialog.DefaultExt
    if saveDialog.execute() then
        local SaveLocation = saveDialog.FileName
        local f, e = io.open(SaveLocation, "w+")
        f:write(text, "\n")
        f:close()
    end
end
local bgmCharSelLocalizeText = ""
for i,s in pairs (core.struct.songs) do
    if s.Disc ~= 0xFFFFFFFF then
      bgmCharSelLocalizeText = bgmCharSelLocalizeText..s.Localize.."\n"..s.Name.."\n"
    end
end
saveFileDialog("Modded BGM Character Select Localize", bgmCharSelLocalizeText)
local bgmTrainingLocalizeText = ""
for i,s in pairs (core.struct.songs) do
    if s.Disc ~= 0xFFFFFFFF then
      bgmTrainingLocalizeText = bgmTrainingLocalizeText.."TRI_QuickChangeBGMV"..(i+0x66).."\n".."["..s.Name.."]".."\n"
    end
end
saveFileDialog("Modded BGM Training Localize", bgmTrainingLocalizeText)
MemoryRecordTools.Disable(memrec)
[DISABLE]
{$asm}
</AssemblerScript>
                    </CheatEntry>
                  </CheatEntries>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
