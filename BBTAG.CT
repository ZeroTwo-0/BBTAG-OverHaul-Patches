}, core.game.moduleAddress, core.game.moduleEndAddress)
core.script.bbscriptCtrlObjExtValues.RegisterObj = {}
core.script.bbscriptCtrlObjExtValues.RegisterObj.Limit = readByte(result)
core.script.bbscriptCtrlObjExtValues.RegisterObj.JumpTableAddress = readPointer(result+0xA)
core.script.bbscriptCtrlObjExtValues.RegisterObj.Address = result
{$asm}
