                    </CheatEntry>
                    <CheatEntry>
                      <ID>21546</ID>
                      <Description>"Setup Original Pointers &amp; Hijack"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript Async="1">[ENABLE]
// Setup Original Pointers and Hijack
{$lua}
if syntaxcheck then return end
if not GeneralTools.WaitForCondition(function()
    return (core ~= nil and
            core.static ~= nil and
            core.static.vTables ~= nil and
            core.static.vTables.charBase ~= nil and
            core.static.vTables.charBase.functions ~= nil)
        end, 60, 3000) then
    error("Wait condition failed.")
end
local charBaseSLOTGetSetFunc = core.static.vTables.charBase.functions[62]

local getterSwitchCase = AoBTools.ScanAoBTable({
    {"FF * * E8", 0x4, {AoBTools.AoBPointerType.NearAddress}},
    {"3D * * * * 0F 87 * * * * FF * * * * * *"}
}, charBaseSLOTGetSetFunc, core.game.moduleEndAddress)
registerSymbol("SLOT_Get_Switch_Case", getterSwitchCase, true)

local setterSwitchCase = AoBTools.ScanAoBTable({
    {"FF * * E8", 0x1},
    {"FF * * E8", 0x4, {AoBTools.AoBPointerType.NearAddress}},
    {"3D * * * * 0F 87 * * * * 0F B6 * * * * * FF * * * * * *"}
}, charBaseSLOTGetSetFunc, core.game.moduleEndAddress)
registerSymbol("SLOT_Set_Switch_Case", setterSwitchCase, true)

core.script.slotGetSetOverride = {}
core.script.slotGetSetOverride.Getter = {}
core.script.slotGetSetOverride.Getter.Limit = readIntegerSigned(getterSwitchCase+0x1)
core.script.slotGetSetOverride.Getter.DefaultAddr = getterSwitchCase+0x7 + readIntegerSigned(getterSwitchCase+0x7) + 0x4
core.script.slotGetSetOverride.Getter.AddrTable = readPointer(getterSwitchCase+0xE)

core.script.slotGetSetOverride.Setter = {}
core.script.slotGetSetOverride.Setter.Limit = readIntegerSigned(setterSwitchCase+0x1)
core.script.slotGetSetOverride.Setter.DefaultAddr = setterSwitchCase+0x7 + readIntegerSigned(setterSwitchCase+0x7) + 0x4
core.script.slotGetSetOverride.Setter.AddrIndexTable = readPointer(setterSwitchCase+0xE)
core.script.slotGetSetOverride.Setter.AddrTable = readPointer(setterSwitchCase+0x15)

local extendedGettersAddr = getAddressSafe("SLOT_Get_Set_Override_Getters_Pointers")
local extendedSettersAddr = getAddressSafe("SLOT_Get_Set_Override_Setters_Pointers")

local pad = 0xC8 --- 200

core.script.slotGetSetOverride.newLimit = pad

local setupPtrTable = function(limit, addrTable, pad, newAddrTable, defaultAddr, indexTable)
    local tmpTbl = {}
    for i=0x0,limit-0x1 do
        local addr = defaultAddr
        if indexTable then
            addr = readPointer(addrTable+(readByte(indexTable+(i))*0x4))
        else
            addr = readPointer(addrTable+((i)*0x4))
        end
        table.insert(tmpTbl, addr)
    end

    for i=limit,pad-0x1 do
        local off = (i)*0x4
        table.insert(tmpTbl, defaultAddr)
    end

    for i,addr in ipairs(tmpTbl) do
        writePointer(newAddrTable+((i-0x1)*0x4), addr)
    end

    local ptr = 0x0
    local index = 0x0
    repeat
        ptr = readPointer(newAddrTable+(index*0x4))
        index = index + 0x1
    until(ptr == 0x0 or index == 10000)
    core.script.slotGetSetOverride.newLimit = index-0x2
end

setupPtrTable(core.script.slotGetSetOverride.Getter.Limit, core.script.slotGetSetOverride.Getter.AddrTable, pad, extendedGettersAddr, core.script.slotGetSetOverride.Getter.DefaultAddr)
setupPtrTable(core.script.slotGetSetOverride.Setter.Limit, core.script.slotGetSetOverride.Setter.AddrTable, pad, extendedSettersAddr, core.script.slotGetSetOverride.Setter.DefaultAddr, core.script.slotGetSetOverride.Setter.AddrIndexTable)

--- Hijack

writeInteger(getterSwitchCase+0x1, core.script.slotGetSetOverride.newLimit)
writePointer(getterSwitchCase+0xE, extendedGettersAddr)

writeInteger(setterSwitchCase+0x1, core.script.slotGetSetOverride.newLimit)
writeBytes(setterSwitchCase+0xB, {0xEB, 0x05}) --- Bypass Index Table
writePointer(setterSwitchCase+0x15, extendedSettersAddr)

if not GeneralTools.WaitForCondition(function()
    return (core.script.matchInitValues ~= nil and
            core.script.matchInitValues.addDynFunc ~= nil)
        end, 60, 3000) then
    error("Wait condition failed.")
end
core.script.matchInitValues.addDynFunc(getAddressSafe("CharBase_Extended_Memory_CleanupFunc"))
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
local getAddr = getAddressSafe("SLOT_Get_Switch_Case")
local setAddr = getAddressSafe("SLOT_Set_Switch_Case")

writeInteger(getAddr+0x1, core.script.slotGetSetOverride.Getter.Limit)
writePointer(getAddr+0xE, core.script.slotGetSetOverride.Getter.AddrTable)

writeInteger(setAddr+0x1, core.script.slotGetSetOverride.Setter.Limit)
writeBytes(setAddr+0xB, {0x0F, 0xB6}) --- Bypass Index Table
writePointer(setAddr+0x15, core.script.slotGetSetOverride.Setter.AddrTable)
core.script.slotGetSetOverride = nil
{$asm}
unregistersymbol(SLOT_Get_Switch_Case)
unregistersymbol(SLOT_Set_Switch_Case)
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>21709</ID>
                      <Description>"Extended CharBase Rollback"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
core.script.extendedCharBaseRollback = {}
if not GeneralTools.WaitForCondition(function()
    return (not isNilAddress(getAddressSafe("CharBase_Extended_Memory_Pointers")))
        end, 60, 3000) then
    error("Wait condition failed.")
end
local addr = getAddressSafe("CharBase_Extended_Memory_Pointers")
core.script.extendedCharBaseRollback.blocksize = readPointer(addr+0x4)-readPointer(addr)
core.script.extendedCharBaseRollback.origBytes = {}
local addr = AoBTools.ScanAoBTable({
    {"89 * * E8 * * * * 8B * * 83 * * 05 * * * *", 0xB}
}, core.game.moduleAddress, core.game.moduleEndAddress)
core.script.extendedCharBaseRollback.CopyAddress = addr
table.insert(core.script.extendedCharBaseRollback.origBytes, readBytes(addr, 0x8, true))
addr = AoBTools.ScanAoBTable({
    {"8D * * * * * * E8 * * * * 8B * * 83 * * 05 * * * *", 0xF}
}, core.game.moduleAddress, core.game.moduleEndAddress)
