                    <CheatEntry>
                      <ID>21543</ID>
                      <Description>"Private Function Extension"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript Async="1">[ENABLE]
{$lua}
if syntaxcheck then return end
local scanAddr = AoBTools.ScanAoBTable({
    {"33 * 89 * * * 8B * * * 89 * * * * * 8D"}
}, core.game.moduleAddress, core.game.moduleEndAddress)

local addr = 0x0
local lastAddr = 0x0

local firstCheck = false

repeat
    addr = AoBTools.ScanAoBTable({
        {"8B * E8 * * * * 8* C0 0F 84"}
    }, scanAddr, scanAddr+(not firstCheck and 0x1000 or 0x10))
    firstCheck = true
    if addr ~= 0x0 and addr ~= nil then
        local tempAddr = addr + 0xB
        scanAddr = tempAddr + readIntegerSigned(tempAddr) + 0x4
        lastAddr = addr
    end
until (addr == 0x0 or addr == nil)

local privFuncExtErrorAddr = lastAddr + 0xB
privFuncExtErrorAddr = privFuncExtErrorAddr + readIntegerSigned(privFuncExtErrorAddr) + 0x4
registerSymbol("Private_Function_Extension", AoBTools.ScanAoBTable({
    {"68"}
}, privFuncExtErrorAddr, privFuncExtErrorAddr+0x1), true)
core.script.privFuncExt = {}
core.script.privFuncExt.OrigBytes = readBytes(privFuncExtErrorAddr, 0x5, true)

--- Izanami ---
core.script.privFuncExt.IzaFunc = {}
core.script.privFuncExt.IzaFunc.Address = AoBTools.ScanAoBTable({
    {"83 78 * 0A 0F * * * * 00 68", 0x3}
}, core.game.moduleAddress, core.game.moduleEndAddress)
core.script.privFuncExt.IzaFunc.OrigBytes = readBytes(core.script.privFuncExt.IzaFunc.Address, 0x1, true)
--- Nine ---
core.script.privFuncExt.NineFunc = {}
core.script.privFuncExt.NineFunc.Address = AoBTools.ScanAoBTable({
    {"83 78 * 0C 0F"},
    {"0F 84"}
}, core.game.moduleAddress, core.game.moduleEndAddress)
core.script.privFuncExt.NineFunc.OrigBytes = readBytes(core.script.privFuncExt.NineFunc.Address, 0x6, true)
{$asm}
alloc(privfuncextmem,$10000,Private_Function_Extension)

