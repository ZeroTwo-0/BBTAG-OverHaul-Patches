table.append(characters, vanillaChars)
table.append(characters, moddedChars)
characters = table.shift(characters, -0x1)
local removeIndexes = {}
for i,tbl in ipairs(characters) do if tbl.ID == "temp" then table.insert(removeIndexes, i) end end
for _,i in ipairs(removeIndexes) do characters[i] = nil end
core.struct.characters = characters
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
core.struct.characters = nil
