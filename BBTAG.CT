                    <CheatEntry>
                      <ID>21810</ID>
                      <Description>"Pat Brightness Scale"</Description>
                      <Options moManualExpandCollapse="1"/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
registerSymbol("PatBright_Hook", AoBTools.ScanAoBTable({
    {"8B 85 C4 F9 FF FF 89 82 B4 00 00 00"}
}, core.game.moduleAddress, core.game.moduleEndAddress), true)
{$asm}
alloc(patBright,$1000,BBTAG.exe)

patBright:
  mov eax,[ebp-0000063C]
  push ebx
  push esi
  push edi
  movzx ebx,byte ptr [ecx+35]
  mov esi,[patBrightNormal]
  cmp ebx,1
  jne pbNotAdd
  mov esi,[patBrightAdd]
pbNotAdd:
  cmp ebx,2
  jne pbScale
  mov esi,[patBrightOther]
pbScale:
  cmp esi,100
  je pbStore
  mov edi,eax
  and edi,FF000000
  movzx ebx,al
  imul ebx,esi
  shr ebx,8
  cmp ebx,FF
  cmova ebx,[pbFF]
  or edi,ebx
  movzx ebx,ah
  imul ebx,esi
  shr ebx,8
  cmp ebx,FF
  cmova ebx,[pbFF]
  shl ebx,8
  or edi,ebx
  shr eax,10
  movzx ebx,al
  imul ebx,esi
  shr ebx,8
  cmp ebx,FF
  cmova ebx,[pbFF]
  shl ebx,10
  or edi,ebx
  mov eax,edi
pbStore:
  pop edi
  pop esi
  pop ebx
  jmp PatBright_Hook+6
pbFF:
  dd FF

patBrightNormal:
  dd 100
patBrightAdd:
  dd 80
patBrightOther:
  dd 100

PatBright_Hook:
  jmp patBright
  db 90


[DISABLE]
PatBright_Hook:
  db 8B 85 C4 F9 FF FF
unregistersymbol(PatBright_Hook)
dealloc(patBright)
</AssemblerScript>
