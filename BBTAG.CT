  test edi,00000200
  db 74 0B // JE
  mov esi,00000001
  or edi,00010000
  mov [ebp-08],edi // Put flags in stack for BBTAG
  test [ebx+core.script.barrierCheckValues.barrierGuardStateCondOffset-8],20000000
  db 75 08 // JNE
  test esi,esi
  je core.script.barrierCheckValues.barrierInputGuardStateEnd
  mov esi,00000001
  jmp core.script.barrierCheckValues.barrierGuardStateCondJMP

barrierGuardStateEnd:
  mov ecx,esi
  call func_BarrierCheckInput
  test eax,eax
  je barrierGuardStateEnd_orig
  mov eax,[esi]
  push 00
  mov ecx,esi
  call dword ptr [eax+00000AF4]
  mov eax,[esi]
  push 00
  mov ecx,esi
  call dword ptr [eax+00000AF8]
  mov eax,[esi]
  push 00
  mov ecx,esi
  call dword ptr [eax+00000ADC]
  jmp core.script.barrierCheckValues.barrierGuardStateEndCondJNE
barrierGuardStateEnd_orig:
  cmp dword ptr [ebp+core.script.barrierCheckValues.barrierGuardStateEndCondOffset],00
  jne core.script.barrierCheckValues.barrierGuardStateEndCondJNE
