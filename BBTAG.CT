  call func_BarrierCheckInput
  test eax,eax
  je core.script.barrierCheckValues.barrierInputGuardStateEnd
  test [ebx+core.script.barrierCheckValues.barrierInputGuardStateOffset],core.script.barrierCheckValues.barrierInputGuardStateBit
  jmp barrierGuardState_return

barrierGuardStateCond:
