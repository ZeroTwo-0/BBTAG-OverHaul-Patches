    {"E8 * * * * FF * * FF * * 8B * * 8B * FF * * E8", 0x5}
}, core.game.moduleAddress, core.game.moduleEndAddress)
registerSymbol("Spoof_BBTAG_Login_ID", result, true)
core.script.spoofBBTAGLoginIDValues = {}
core.script.spoofBBTAGLoginIDValues.origBytes = readBytes(result, 0x6, true)
core.script.spoofBBTAGLoginIDValues.randomIDBytes = {}
for i=0x1,0x8 do
    table.insert(core.script.spoofBBTAGLoginIDValues.randomIDBytes, math.random(0x0,i == 0x8 and 0x7F or 0xFF))
end
{$asm}

alloc(newmem,$1000)

label(spoofBBTAGLoginID)
label(spoofBBTAGLoginID_return)

label(spoofBBTAGLoginID_randomID)

