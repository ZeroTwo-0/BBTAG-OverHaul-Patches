  mov eax,[edi+0000001C]
  jmp SLOT_Get_Set_Override_Getters_end

SLOT_211_get:// Persona SLOT_127
  mov esi,edi
  mov ecx,esi
  call SLOT_211_get_sub
  mov ecx,esi
  mov edi,eax
  call SLOT_211_get_sub2
  imul eax,edi
  jmp SLOT_Get_Set_Override_Getters_end
SLOT_211_get_sub:
  push esi
  mov esi,ecx
  mov ecx,[esi+00000208]
  test ecx,ecx
  jne SLOT_211_get_sub_part2_end
  mov ecx,[esi+0000021C]
  test ecx,ecx
  je SLOT_211_get_sub_part2
  call SLOT_211_get_sub
  mov ecx,eax
  mov eax,[esi+00000278]
  add eax,ecx
  pop esi
  ret
SLOT_211_get_sub_part2:
  mov eax,[esi+00000268]
  test eax,00002000
  je SLOT_211_get_sub_lastresort
  test eax,40000000
  je SLOT_211_get_sub_lastresort
  mov ecx,[esi+00000498]
  call SLOT_211_get_sub
SLOT_211_get_sub_part2_end:
  add eax,[esi+00000278]
  pop esi
  ret
SLOT_211_get_sub_lastresort:
  mov eax,[esi+00000278]
  pop esi
  ret
SLOT_211_get_sub2:
  call SLOT_211_get_sub2_sub
  neg eax
  sbb eax,eax
  and eax,-02
  inc eax
  ret
SLOT_211_get_sub2_sub:
  push esi
  push edi
  mov edi,ecx
  lea esi,[edi+0000020C]
  mov ecx,esi
  call BBTAG.exe+5EFA30
  test eax,eax
  je SLOT_211_get_sub2_sub_end
SLOT_211_get_sub2_sub_loop:
  mov ecx,esi
  call BBTAG.exe+5EFA30
  mov edi,eax
  lea esi,[edi+0000020C]
  mov ecx,esi
  call BBTAG.exe+5EFA30
  test eax,eax
  jne SLOT_211_get_sub2_sub_loop
SLOT_211_get_sub2_sub_end:
  mov eax,[edi+00000274]
  pop edi
  pop esi
  ret

