                  <CheatEntries>
                    <CheatEntry>
                      <ID>20674</ID>
                      <Description>"Character"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript Async="1">[ENABLE]
{$lua}
if syntaxcheck then return end
core.framework.model.Character = {}
core.framework.model.Character.Name = class("core.framework.model.Character.Name", nil, {
    members = {
        Short = {
            value = ""
        },
        Acronym = {
            value = {}
        },
        Simple  = {
            value = ""
        },
        Full = {
            value = ""
        },
        Aliases = {
            value = {}
        }
    },
    ctor = function(this, parent_ctor, arg)
        if arg == nil then return end
        local argCount = table.length(arg)
        if argCount &lt; 0x2 then
            error("class takes at least 2 arguments")
        end
        local short = ""
        local acronym = {}
        local simple = ""
        local full = ""
        local aliases = {}
        if argCount == 0x2 then
            short = arg[0x1]
            acronym = arg[0x2]
            simple = short
            full = short
        elseif argCount == 0x3 then
            short = arg[0x1]
            acronym = arg[0x2]
            simple = arg[0x3]
            full = simple
        elseif argCount == 0x4 then
            short = arg[0x1]
            acronym = arg[0x2]
            simple = arg[0x3]
            full = arg[0x4]
        elseif argCount == 0x5 then
            short = arg[0x1]
            acronym = arg[0x2]
            simple = arg[0x3]
            full = arg[0x4]
            aliases = arg[0x5]
        end

        if type(short) ~= "string" then
            error("Value for field \"Short\" must be a string")
        end
        if type(acronym) == "string" then
            acronym = {acronym}
        elseif type(acronym) ~= "table" then
            error("Value for field \"Acronym\" must be a string or table")
        end
        table.setDefault(acronym, acronym[0x0] or acronym[0x1])
        if type(simple) ~= "string" then
            error("Value for field \"Simple\" must be a string")
        end
        if type(full) ~= "string" then
            error("Value for field \"Full\" must be a string")
        end
        if type(aliases) == "string" then
            aliases = {aliases}
        elseif type(aliases) ~= "table" then
            error("Value for field \"Aliases\" must be a string or table")
        end
        table.setDefault(aliases, aliases[0x0] or aliases[0x1])

        this.Short = short
        this.Acronym = acronym
        this.Simple  = simple
        this.Full = full
        this.Aliases = aliases
    end
})
table.setDefault(core.framework.model.Character,
class("core.framework.model.Character", nil, {
    members = {
        Name = {
            value = new(core.framework.model.Character.Name)
        },
        Fate = {
            value = 0x0
        },
        Enabled = {
            value = true
        },
        Locked = {
            value = true
        },
        CharSubVoiceFlags = {
            value = 0x0
        },
        -- ???
        -- ???
        ImageFolder = {
            value = 0x0
        }
    },
    ctor = function(this, parent_ctor, arg)
        if arg == nil then return end
        local argCount = table.length(arg)
        if argCount &lt; 0x2 then
            error("class takes at least 2 arguments")
        end
        if argCount == 0x2 then
            this.Name = arg[0x1]
        end
    end
}))
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
core.framework.model.Character = nil
{$asm}
</AssemblerScript>
