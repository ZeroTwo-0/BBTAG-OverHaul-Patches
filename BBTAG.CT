  lea ecx,[spoofBBTAGLoginID_randomID]
  push [ecx+04]
  push [ecx]
  jmp spoofBBTAGLoginID_return

spoofBBTAGLoginID_randomID:
{$lua}
local str = 'db '
for i,b in ipairs(core.script.spoofBBTAGLoginIDValues.randomIDBytes) do
    str=str..NumberToHexString(b)..' '
end
return str
{$asm}


