core.script.matchInitValues.addDynFunc = function(callAddr)
    local addr = getAddressSafe("matchInit_dynamicPointers")
    local i = 0x0
    local ptr = 0x0
    repeat
        ptr = readPointer(addr+(i*PointerSize))
        i = i + 0x1
    until(ptr == 0x0 or i &gt; 0x100)
    if ptr == 0x0 then
        writePointer(addr+((i-0x1)*PointerSize), callAddr)
    end
end
