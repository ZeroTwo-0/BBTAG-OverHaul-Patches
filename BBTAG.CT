writeByte(core.script.announcerPointerOverride.CharSelNamesAddr-0x1, 0xB5)
writeBytes(core.script.announcerPointerOverride.CharSelNamesAddr, core.script.announcerPointerOverride.CharSelNamesOrigBytes)
writeByte(core.script.announcerPointerOverride.WinNamesAddr-0x1, 0xB5)
writeBytes(core.script.announcerPointerOverride.WinNamesAddr, core.script.announcerPointerOverride.WinNamesOrigBytes)
core.script.announcerPointerOverride = nil
{$asm}
dealloc(Announcer_Char_Pointers_Override_Memory)
unregisterSymbol(Announcer_Char_Pointers_Override_Memory)
</AssemblerScript>
