                      <Description>"Modify DANGER check eff"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript Async="1">[ENABLE]
{$lua}
if syntaxcheck then return end
autoAssemble([[
alloc(AstralFlashOverwrite,$1000,BBTAG.exe)
registersymbol(AstralFlashOverwrite)
]])

{$asm}
BBTAG.exe+3E42B8:
jmp DangerEffOverwrite
DangerEffOverwrite:
  or dword ptr [ebx+24],20
  mov ecx,edi
  push eax
  sub esp,08
  mov eax,esp
  mov [eax],00000002
  mov [eax+04],000000C8
  call BBTAG.exe+3634B0
  test eax,eax
  pop eax
  jne DisableDanger
  and dword ptr [ebx+24],-21
  jmp ExitDangerFunc
DisableDanger:
  mov [edi+12F0],20
  jmp ExitDangerFunc
ExitDangerFunc:
  pop edi
  pop esi
  pop ebx
  mov esp,ebp
  pop ebp
  ret

BBTAG.exe+3E0896:
  jmp AstralFlashOverwrite
AstralFlashOverwrite:
  push eax
  mov ecx,edi
  call AstralFlashFalseCond_call
  or dword ptr [ebx+24],20
  test eax,eax
  pop eax
  je AstralFlashFalse
  and dword ptr [ebx+24],-21
AstralFlashFalse:
  jmp BBTAG.exe+3E08A2


AstralFlashFalseCond_call:
  push ebp
  mov ebp,esp
  push ebx
  push esi
  push edi
  mov edi,ecx
  call BBTAG.exe+3B8730
  xor ecx,ecx
  cmp eax,000061A8
  mov eax,ecx
  mov ecx,00000001
  cmovae eax,ecx
  test eax,eax
  je AstralFlashFalseCond_call_false
  mov eax,[edi+000001FC]
  mov eax,[eax+0000015C]
  and eax,00080000
  test eax,eax
  je AstralFlashFalseCond_call_false
  mov ecx,[edi+000001FC]
  call BBTAG.exe+3649F0
  mov ecx,eax
  call BBTAG.exe+3652D0
  test eax,eax
  je AstralFlashFalseCond_call_false
  mov eax,00000001
  pop edi
  pop esi
  pop ebx
  mov esp,ebp
  pop ebp
  ret
AstralFlashFalseCond_call_false:
  pop edi
  pop esi
  xor eax,eax
  pop ebx
  mov esp,ebp
  pop ebp
  ret

[DISABLE]

{$lua}
if syntaxcheck then return end

{$asm}
unregistersymbol(AstralFlashOverwrite)
dealloc(AstralFlashOverwrite)


