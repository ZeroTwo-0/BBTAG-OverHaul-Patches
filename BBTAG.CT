core.script.cfOverDriveValues.addCFOverDriveResonanceODCancelCall = result+0x1 + readIntegerSigned(result+0x1) + 0x4
registerSymbol("Add_CF_OverDrive_Resonance_OD_Cancel_BBScript", result, true)

result = AoBTools.ScanAoBTable({
    {"E8 * * * * E8 * * * * 83 * * * * * * 0F 85 * * * * 8B", 0x1, {AoBTools.AoBPointerType.NearAddress}},
    {"6A * 6A"}
}, core.game.moduleAddress, core.game.moduleEndAddress)
registerSymbol("Add_CF_OverDrive_Skip_Active_Flow_Resetter", result, true)

local odLoopTimeArea = AoBTools.ScanAoBTable({
    {"83 * * * * * 01 74 * 8B * * * * * 83 * * 75", 0x13, {AoBTools.AoBPointerType.CloseJump}}
}, core.game.moduleAddress, core.game.moduleEndAddress)

result = AoBTools.ScanAoBTable({
    {"83 * * 72", 0x2}
}, odLoopTimeArea, core.game.moduleEndAddress)
core.script.cfOverDriveValues.OrigResonanceODLoopStartupTimeByte = readByte(result)
registerSymbol("Add_CF_OverDrive_Use_CF_Loop_Startup_Time", result, true)

result = AoBTools.ScanAoBTable({
    {"83 * * * * * 01 74 * 8B * * * * * 83 * * 75", 0x13, {AoBTools.AoBPointerType.CloseJump}},
    {"83 * * 72", 0x2}
}, odLoopTimeArea, core.game.moduleEndAddress)
core.script.cfOverDriveValues.OrigResonanceODAirLoopStartupTimeByte = readByte(result)
registerSymbol("Add_CF_OverDrive_Use_CF_Air_Loop_Startup_Time", result, true)

local getSwitchCaseAddr = function(ptrTblAddr, index)
  return readPointer(ptrTblAddr + index * 0x4)
end
local switchCasePtrTblAddr = AoBTools.ScanAoBTable({
    {"0F 85 * * * * 8B * * * * * 3D * * * * 0F 87 * * * * FF * * * * * *", 0x1A, {AoBTools.AoBPointerType.FarAddress}}
}, core.game.moduleAddress, core.game.moduleEndAddress)

local charBaseVTable = AoBTools.ScanAoBTable({
    {"E8 * * * * 33 * C7 * * * * * 89 * * * * * 89 * * * * * 89 * * * * * 68", 0x9, {AoBTools.AoBPointerType.FarAddress}}
}, core.game.moduleAddress, core.game.moduleEndAddress)

local ptr = readPointer(charBaseVTable + AoBTools.ScanAoBTable({
    {"FF * * FF * * * * *", 0x5, {AoBTools.AoBPointerType.Offset, 0x4, true}}
}, getSwitchCaseAddr(switchCasePtrTblAddr, 0x7B), core.game.moduleEndAddress))
registerSymbol("Add_CF_OverDrive_Use_CF_Air_JumpDown_State", AoBTools.ScanAoBTable({
    {"83 * * * * * * 76 * 8B 03", 0x7}
}, ptr, core.game.moduleEndAddress), true)
result = AoBTools.ScanAoBTable({
    {"83 * * * * * * 76 * 8B 03 83", 0x7}
}, ptr, core.game.moduleEndAddress)
core.script.cfOverDriveValues.OrigJumpDownStateJNAOff = readByte(result+0x1)
core.script.cfOverDriveValues.addCFOverDriveJumpDownStateJNA = result+0x1 + readByteSigned(result+0x1) + 0x1
registerSymbol("Add_CF_OverDrive_Use_CF_Air_JumpDown_State2", result, true)
