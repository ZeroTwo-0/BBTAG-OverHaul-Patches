            <CheatEntry>
              <ID>3430</ID>
              <Description>"Char Slots Memory Override"</Description>
              <Options moManualExpandCollapse="1" moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript Async="1">[ENABLE]
{$lua}
if syntaxcheck then return end
if GeneralTools.WaitForCondition(function()
    return (core.struct ~= nil and
            core.struct.characters ~= nil)
        end, 60, 3000) then
    local charSlotsOverrideMem = allocateMemory(0x10000)
    registerSymbol("charSlotsOverrideMem", charSlotsOverrideMem, true)
    autoAssemble([[
    label(Char_Slots_Override_Memory)

    charSlotsOverrideMem:
      db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 03 00 00 00 00 00 00 00 03 00 00 00 00 00 00 00 03 00 00 00 00 00 00 00 03 00 00 00 00 00 00 00 03 00 00 00 00 00 00 00 03 00 00 00 00 00 00 00 03 00 00 00 00 00 00 00 03 00 00 00 00 00 00 00 03 00 00 00 00 00 00 00 03 00 00 00 00 00 00 00 00 00 00 00 6B 65 65 70 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 6E 75 6C 6C 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
    Char_Slots_Override_Memory:

    registersymbol(Char_Slots_Override_Memory)
    ]])
    local charSlotsObjVTableAddr = AoBTools.ScanAoBTable({
        {"B8 * * * * E9 * * * * 68 * * * * 68 * * * * E8", 0x10, {AoBTools.AoBPointerType.FarAddress}}
    }, core.game.moduleAddress, core.game.moduleEndAddress)+0x4
    local funcIndex = 0x74
    core.script.charSlotsAddrCodeTbl = {}
    local addr = readPointer(charSlotsObjVTableAddr+(0x4*funcIndex))+0x1
    core.script.charSlotsAddrCodeTbl.CharSlotsObjSetupCall = addr
    core.script.charSlotsOrigAddr = readPointer(addr)

    core.script.charSlotsAddrCodeTbl.Override2 = AoBTools.ScanAoBTable({
        {"33 * E8 * * * * 8B * * * * * 83 * * 0F 84 * * * * 33", 0x3, {AoBTools.AoBPointerType.NearAddress}}
    }, core.game.moduleAddress, core.game.moduleEndAddress)+0x1

    local switchCaseAddr = AoBTools.ScanAoBTable({
        {"0F * * 83 * * 0F 87 * * * * 0F B6 * * * * * FF"}
    }, core.game.moduleAddress, core.game.moduleEndAddress)
    local getSwitchCaseFuncCharSlotsAddr = function(addr, index, count)
        if not count then count = 0x1 end
        results= {}
        local addr = readPointer(readPointer(switchCaseAddr+0x16) + (readByteSigned(readPointer(switchCaseAddr+0xF)+index) * 0x4))
        for c=0x1,count do
            local result = AoBTools.ScanAoBTable({
                {"6A * 6A * B9", 0x5}
            }, addr, addr+0x500)
            table.insert(results, result)
            addr = result
        end
        return results
    end
    core.script.charSlotsAddrCodeTbl.Override3 = getSwitchCaseFuncCharSlotsAddr(switchCaseAddr, 0xD)[0x1]
    local results = getSwitchCaseFuncCharSlotsAddr(switchCaseAddr, 0x10, 0x2)
    core.script.charSlotsAddrCodeTbl.Override4 = results[0x1]
    core.script.charSlotsAddrCodeTbl.Override5 = results[0x2]
    results = getSwitchCaseFuncCharSlotsAddr(switchCaseAddr, 0x11, 0x3)
    core.script.charSlotsAddrCodeTbl.Override6 = results[0x1]
    core.script.charSlotsAddrCodeTbl.Override7 = results[0x2]
    core.script.charSlotsAddrCodeTbl.Override8 = results[0x3]
    core.script.charSlotsAddrCodeTbl.Override9 = getSwitchCaseFuncCharSlotsAddr(switchCaseAddr, 0x12)[0x1]
    core.script.charSlotsAddrCodeTbl.Override10 = getSwitchCaseFuncCharSlotsAddr(switchCaseAddr, 0x50)[0x1]
    core.script.charSlotsAddrCodeTbl.Override11 = getSwitchCaseFuncCharSlotsAddr(switchCaseAddr, 0x55)[0x1]

    local memAddr = getAddressSafe("Char_Slots_Override_Memory")

    writeBytes(memAddr, readBytes(core.script.charSlotsOrigAddr, 0x40B0, true))
    for i,charData in pairs(core.struct.characters) do
        local addr = memAddr+(i*0xB8)
        local writer = BinaryTools.CreateWriter(addr)
        writer.writeString(charData.ID:lower(), 0x20)
        writer.writeString(charData.ID:upper(), 0x20)
        writer.writeString(charData.ShortName:upper(), 0x20)
        if charData.AltID then
            writer.writeString(charData.AltID:lower(), 0x20)
        else
            writer.writeString(charData.ID:lower(), 0x20)
        end
        writer.writeInt32(charData.Unlocked and 0x1 or 0x0)
        writer.writeInt32(charData.DLCUnlocked and 0x1 or 0x0)
        writer.writeInt64(0x0)
        writer.writeInt64(charData.SubVoiceCharFlags)
        writer.writeInt64(0x0)
        writer.writeInt32(charData.Unk0xA0)
        writer.writeInt32(0x0)
        writer.writeInt32(charData.Unk0xA8)
        writer.writeInt32(0x0)
        writer.writeInt32(charData.SpriteFolder)
        writer.writeInt32(0x0)
    end
    local lastCharIndex = 0x0
    for k,_ in pairs(core.struct.characters) do if k &gt; lastCharIndex then lastCharIndex = k end end
    writeByte(memAddr-0x9, lastCharIndex+0x1)
    writeByte(memAddr+0x2E00, lastCharIndex+0x1)

    if memAddr and memAddr ~= 0x0 then
        for _,oa in pairs(core.script.charSlotsAddrCodeTbl) do
           writeInteger(oa, memAddr)
        end
    end
else
    error("Wait condition failed.")
end
{$asm}

[DISABLE]

{$lua}
if syntaxcheck then return end
for _,addr in pairs(core.script.charSlotsAddrCodeTbl) do
    writeInteger(addr, core.script.charSlotsOrigAddr)
end
core.script.charSlotsAddrCodeTbl = nil
core.script.charSlotsOrigAddr = nil
{$asm}
unregisterSymbol(Char_Slots_Override_Memory)
{$lua}
if syntaxcheck then return end
deAlloc("charSlotsOverrideMem")
unregisterSymbol("charSlotsOverrideMem")
{$asm}
</AssemblerScript>
