              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>20971</ID>
                  <Description>"Music Pointer Override"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript Async="1">[ENABLE]
{$lua}
if syntaxcheck then return end
autoAssemble([[
alloc(MusicPointerOverrideMemory,$10000,BBTAG.exe)
registersymbol(MusicPointerOverrideMemory)
]])

core.script.MusicPointerOverride = {}
core.script.MusicPointerOverride.MusicSlotPTR = AoBTools.ScanAoBTable({
    {"8B BB * * * * 8D 9E * * * * 8B CB"},
    {"FF 34 BD", 0x3}
}, core.game.moduleAddress, core.game.moduleEndAddress)
core.script.MusicPointerOverride.MusicSlot = readPointer(core.script.MusicPointerOverride.MusicSlotPTR)
local memAddr = getAddressSafe("MusicPointerOverrideMemory")
writeBytes(memAddr, readBytes(core.script.MusicPointerOverride.MusicSlot, 0x19c, true))
writeInteger(core.script.MusicPointerOverride.MusicSlotPTR, memAddr)

local OffsetList = {}
local stringByteTable = {}

for i,s in pairs (core.struct.songs) do
    --if s.Disc ~= -1 then
      table.insert (OffsetList, #stringByteTable)
      local strByteTbl = stringToByteTable(s.FileName)
      table.insert (strByteTbl, 0x00)
      local remPadding = #strByteTbl %4
      for j = 1, remPadding do
          table.insert (strByteTbl, 0x00)
      end
      for j,b in ipairs (strByteTbl) do
          table.insert (stringByteTable, b)
      end
    --end
end

local ptrAddr = memAddr+0x19c
local stringAddr = ptrAddr+(#OffsetList*4)

for i,o in ipairs (OffsetList) do
    writePointer(ptrAddr+((i-1)*4),stringAddr+o)
end
   writeBytes(stringAddr,stringByteTable)
{$asm}

[DISABLE]

{$lua}
if syntaxcheck then return end
writeInteger(core.script.MusicPointerOverride.MusicSlotPTR, core.script.MusicPointerOverride.MusicSlot)
core.script.MusicPointerOverride = nil
{$asm}
unregistersymbol(MusicPointerOverrideMemory)
dealloc(MusicPointerOverrideMemory)


