                  <Options moManualExpandCollapse="1" moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
                  <GroupHeader>1</GroupHeader>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>21748</ID>
                      <Description>"cssCrashFix 2 (character select index array)"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript Async="1">[ENABLE]
alloc(cssIdxHook,$80)
alloc(cssIdxHook2,$40)
alloc(cssIdxExtra,$300)          // 192 more dwords -&gt; slots 64..255
registersymbol(cssIdxExtra)
label(cssIdxHigh)
label(cssIdxReturn)
label(cssIdxHigh2)
label(cssIdxReturn2)

// first use of the stack index array: +44A699
cssIdxHook:
  cmp eax,100                    // eax = slot*4; &gt;= 0x100 means slot &gt;= 64
  jae cssIdxHigh
  lea ebx,[ebp-110]
  add ebx,eax
  jmp cssIdxReturn
cssIdxHigh:
  lea ebx,[eax+cssIdxExtra-100]  // &amp;extra[slot-64]
  jmp cssIdxReturn

// second use: +44A7D2
cssIdxHook2:
  mov eax,[ebp-2B4]              // slot*4
  cmp eax,100
  jae cssIdxHigh2
  lea eax,[ebp+eax-110]          // &amp;arr[slot] (original behavior)
  jmp cssIdxReturn2
cssIdxHigh2:
  lea eax,[eax+cssIdxExtra-100]  // &amp;extra[slot-64]
  jmp cssIdxReturn2

BBTAG.exe+44A699:
  jmp cssIdxHook
  db 90 90 90                    // 8 bytes: 8D 9D F0 FE FF FF 03 D8
cssIdxReturn:

BBTAG.exe+44A7D2:
  jmp cssIdxHook2
  db 90 90 90 90 90 90 90        // 12 bytes total
cssIdxReturn2:

[DISABLE]
BBTAG.exe+44A699:
  db 8D 9D F0 FE FF FF 03 D8
BBTAG.exe+44A7D2:
  db 8D 85 F0 FE FF FF 03 85 4C FD FF FF
unregistersymbol(cssIdxExtra)
dealloc(cssIdxHook)
dealloc(cssIdxHook2)
dealloc(cssIdxExtra)
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>21749</ID>
                      <Description>"cssCrashFix 3 (portrait positions)"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript Async="1">[ENABLE]
alloc(cssPosL,$800)      // 256 slots x (x,y) floats
alloc(cssPosR,$800)
registersymbol(cssPosL)
registersymbol(cssPosR)

// writers (op 10392 / 10393)
BBTAG.exe+4348D6:
  movss [cssPosL+eax*8],xmm0
BBTAG.exe+4348E4:
  movss [cssPosL+eax*8+4],xmm0
BBTAG.exe+434916:
  movss [cssPosR+eax*8],xmm0
BBTAG.exe+434924:
  movss [cssPosR+eax*8+4],xmm0

// readers
BBTAG.exe+438549:
  fld dword ptr [cssPosL+ebx*8]
BBTAG.exe+43855C:
  fld dword ptr [cssPosL+ebx*8+4]
BBTAG.exe+43856F:
  fld dword ptr [cssPosL+ebx*8]
BBTAG.exe+438584:
  fld dword ptr [cssPosL+ebx*8+4]
BBTAG.exe+4385B0:
  fld dword ptr [cssPosR+ebx*8]
BBTAG.exe+4385C3:
  fld dword ptr [cssPosR+ebx*8+4]
BBTAG.exe+4385DC:
  fadd dword ptr [cssPosR+ebx*8]
BBTAG.exe+4385EF:
  fld dword ptr [cssPosR+ebx*8+4]

[DISABLE]
BBTAG.exe+4348D6:
  db F3 0F 11 84 C1 E4 28 00 00
BBTAG.exe+4348E4:
  db F3 0F 11 84 C1 E8 28 00 00
BBTAG.exe+434916:
  db F3 0F 11 84 C1 E4 2A 00 00
BBTAG.exe+434924:
  db F3 0F 11 84 C1 E8 2A 00 00
BBTAG.exe+438549:
  db D9 84 DA E4 28 00 00
BBTAG.exe+43855C:
  db D9 84 D8 E8 28 00 00
BBTAG.exe+43856F:
  db D9 84 DA E4 28 00 00
BBTAG.exe+438584:
  db D9 84 D8 E8 28 00 00
BBTAG.exe+4385B0:
  db D9 84 D8 E4 2A 00 00
BBTAG.exe+4385C3:
  db D9 84 D8 E8 2A 00 00
BBTAG.exe+4385DC:
  db D8 84 D8 E4 2A 00 00
BBTAG.exe+4385EF:
  db D9 84 D8 E8 2A 00 00
unregistersymbol(cssPosL)
unregistersymbol(cssPosR)
dealloc(cssPosL)
dealloc(cssPosR)
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>21751</ID>
                      <Description>"cssCrashFix 4 (second stack array)"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript Async="1">[ENABLE]
alloc(cssArr2,$400)            // 256 slots x dword (replaces stack array [ebp-210])
registersymbol(cssArr2)

BBTAG.exe+44A3AB:
  mov [cssArr2+esi*4],ebx      // was: mov [ebp+esi*4-210],ebx

BBTAG.exe+44A754:
  mov edi,[cssArr2+edi]        // was: mov edi,[ebp+edi-210]
  nop

[DISABLE]
BBTAG.exe+44A3AB:
  db 89 9C B5 F0 FD FF FF
BBTAG.exe+44A754:
  db 8B BC 3D F0 FD FF FF
unregistersymbol(cssArr2)
dealloc(cssArr2)
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>21759</ID>
                      <Description>"cssCrashFix 6 (load queue size)"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript Async="1">[ENABLE]
{$lua}
-- File load request pool at BBTAG.exe+80A798:
--   +00 base ptr   +04 capacity (vanilla 0x96 = 150)   +08 next-free hint
--   +10 used count  entries are 0x124 bytes, +118 = in-use flag
-- BBTAG.exe+14260 returns 0 (request silently dropped) when used &gt;= capacity.
if syntaxcheck then return end
local q      = getAddress("BBTAG.exe+80A798")
local ESIZE  = 0x124
local NEWCAP = 0x400
pause()
local oldBase = readInteger(q)
local oldCap  = readInteger(q+4)
if oldCap &lt; NEWCAP then
  local newBase = allocateMemory(NEWCAP*ESIZE)
  copyMemory(oldBase, oldCap*ESIZE, newBase)
  lqOldBase, lqOldCap, lqNewBase = oldBase, oldCap, newBase
  writeInteger(q, newBase)
  writeInteger(q+4, NEWCAP)
end
unpause()
{$asm}

[DISABLE]
{$lua}
-- only disable on the main menu / lobby (nothing loading)
if syntaxcheck then return end
if lqOldBase then
  local q = getAddress("BBTAG.exe+80A798")
  pause()
  copyMemory(lqNewBase, lqOldCap*0x124, lqOldBase)
  writeInteger(q, lqOldBase)
  writeInteger(q+4, lqOldCap)
  writeInteger(q+8, 0)
  unpause()
  lqOldBase = nil
end
{$asm}
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>21761</ID>
                      <Description>"cssCrashFix 7 (load list nodes 150 -&gt; +2048)"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
// BBTAG.exe+12EF0 pops a list node from the loader's free list ([obj+2C], 150 nodes
// total) with BBTAG.exe+11420. When all 150 are busy it returns 0 and
// BBTAG.exe+12F52 writes to [0+0C] -&gt; crash. This hands out extra nodes instead.
// Node = 0x10 bytes: +0 vtable (BBTAG.exe+662A04), +4 next, +8 prev, +C request index.
alloc(lnCode,$80)
alloc(lnPool,$8000)          // 2048 extra nodes
alloc(lnNext,4)
registersymbol(lnPool)
registersymbol(lnNext)
label(lnDone)
label(lnReturn)

lnNext:
  dd lnPool

lnCode:
  lea ecx,[esi+2C]
  call BBTAG.exe+11420
  test eax,eax
  jnz lnDone
  mov eax,[lnNext]
  cmp eax,lnPool+8000
  jae lnDone                 // pool used up (eax nonzero but past end) -&gt; handled below
  add dword ptr [lnNext],10
  mov dword ptr [eax],BBTAG.exe+662A04
  mov dword ptr [eax+4],0
  mov dword ptr [eax+8],0
  mov dword ptr [eax+C],0
  jmp lnReturn
lnDone:
  cmp eax,lnPool+8000
  jne lnReturn
  xor eax,eax
  jmp lnReturn

BBTAG.exe+12F3D:
  jmp lnCode
  db 90 90 90
lnReturn:

[DISABLE]
// only turn off on the main menu; nodes stay allocated on purpose
BBTAG.exe+12F3D:
  db 8D 4E 2C E8 DB E4 FF FF
dealloc(lnCode)
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>21763</ID>
                      <Description>"cssCrashFix 8 (1st-pick portrait slide table, ids 64+)"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
// The 1st-pick portrait slide-in reads a per-character value from a stack
// table [ebp-424] (4 dwords per character ID, IDs 0-63 only, all zero).
// IDs 64+ read past the table into other stack data (pointers / the stack
// cookie), so the portrait slides to a garbage X and ends up off-screen.
// Two copies of the lookup exist; both now return 0 for IDs 64+.
//   BBTAG.exe+4395A8  lea eax,[esi+ebx*4] / mov esi,[ebp+eax*4-424]
//   BBTAG.exe+438FF3  mov esi,[ebp+eax*4-424]   (per-frame path, jumps to +4395B2)
alloc(slideFix,$40)
alloc(slideFix2,$40)
label(slideZero)
label(slideReturn)
label(slideZero2)

slideFix:
  lea eax,[esi+ebx*4]
  cmp ebx,40
  jae slideZero
  mov esi,[ebp+eax*4-424]
  jmp slideReturn
slideZero:
  xor esi,esi
  jmp slideReturn

slideFix2:
  cmp ebx,40
  jae slideZero2
  mov esi,[ebp+eax*4-424]
  jmp BBTAG.exe+438FFA
slideZero2:
  xor esi,esi
  jmp BBTAG.exe+438FFA

BBTAG.exe+4395A8:
  jmp slideFix
  db 90 90 90 90 90
slideReturn:

BBTAG.exe+438FF3:
  jmp slideFix2
  db 90 90

[DISABLE]
BBTAG.exe+4395A8:
  db 8D 04 9E 8B B4 85 DC FB FF FF
BBTAG.exe+438FF3:
  db 8B B4 85 DC FB FF FF
dealloc(slideFix)
dealloc(slideFix2)
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>21768</ID>
                      <Description>"cssCrashFix 9 (palette preview: out-of-range palette -&gt; wrap)"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
// BBTAG.exe+31240 (ecx = palette list, [ebp+08] = palette index) looks the
// index up with BBTAG.exe+1CDE0. The palette-select preview's list only has
// the palettes loaded for that character (vanilla: 20 base + 20 sub = 0x28).
// With the 99-palette patch the index can be up to 98 (base) or 99+98 (sub),
// so the lookup returns 0 and BBTAG.exe+312AE crashes.
// If the index is past the end of the list, wrap it:
//   base  p        -&gt; p mod half
//   sub   99 + p   -&gt; half + (p mod half)        (half = count / 2)
// Indexes that are in range are untouched.
alloc(palWrap,$80)
label(palBase)
label(palDone)
label(palOk)
label(palReturn)

palWrap:
  mov edi,[ebp+08]
  mov ebx,ecx
  mov eax,[ebx+0C]          // entry count
  cmp edi,eax
  jb palOk
  push edx
  push ecx
  mov ecx,eax
  shr ecx,1                 // half = base palette count
  jz palDone
  cmp edi,63
  jb palBase
  lea eax,[edi-63]
  xor edx,edx
  div ecx
  lea edi,[edx+ecx]
  jmp palDone
palBase:
  mov eax,edi
  xor edx,edx
  div ecx
  mov edi,edx
palDone:
  pop ecx
  pop edx
  mov [ebp+08],edi          // keep the arg consistent for the rest of the function
palOk:
  jmp palReturn

BBTAG.exe+31243:
  jmp palWrap
//BBTAG.exe+43B468:
//  db EB
palReturn:

[DISABLE]
BBTAG.exe+31243:
  db 8B 7D 08 8B D9
dealloc(palWrap)
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>21746</ID>
                      <Description>"cssCrashFix 1 (slot resource IDs, offline + online range)"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript Async="1">[ENABLE]
// Side table for slot resource IDs 0x1000-0x11FF (8 bytes each):
//   0x1000-0x10BF  offline CSS slots 64-255   (0x161+slot in vanilla)
//   0x10C0-0x11FF  online  CSS slots 53-255   (0x433+slot in vanilla, see cssCrashFix 10)
alloc(slotIdCode,$400)
alloc(slotIdTable,$1000)
registersymbol(slotIdTable)
label(regHook)
label(lkHook)
label(lkNull)
label(lkNormal)
label(siteHook)
label(siteHigh)
label(cssHook)
label(cssHigh)
label(cssFallback)
label(cssReturn)

slotIdCode:
regHook:
  mov edi,[ebp+08]
  mov ebx,ecx
  cmp edi,1000
  jb BBTAG.exe+27AACA
  cmp edi,1200
  jae BBTAG.exe+27AACA
  sub edi,1000
  mov ebx,slotIdTable
  jmp BBTAG.exe+27AADA

lkHook:
  mov eax,[ebp+08]
  cmp eax,1000
  jb lkNormal
  cmp eax,1200
  jae lkNull
  mov eax,[slotIdTable+eax*8-8000]
  pop ebp
  ret 4
lkNull:
  xor eax,eax
  pop ebp
  ret 4
lkNormal:
  cmp eax,6B9
  jmp BBTAG.exe+27ABFB

siteHook:
  cmp edi,40
  jae siteHigh
  lea esi,[edi+161]
  jmp BBTAG.exe+44CDFA
siteHigh:
  lea esi,[edi+FC0]
  jmp BBTAG.exe+44CDFA

cssHook:
  cmp esi,40
  jae cssHigh
  lea ecx,[esi+161]
  push ecx
  mov ecx,[ebp-2B8]
  call BBTAG.exe+27ABF0
  jmp cssReturn
cssHigh:
  lea ecx,[esi+FC0]
  push ecx
  mov ecx,[ebp-2B8]
  call BBTAG.exe+27ABF0
  test eax,eax
  jnz cssReturn
cssFallback:
  push 161
  mov ecx,[ebp-2B8]
  call BBTAG.exe+27ABF0
  jmp cssReturn

BBTAG.exe+27AAC5:
  jmp regHook
BBTAG.exe+27ABF3:
  jmp lkHook
  db 90 90 90
BBTAG.exe+44CDF4:
  jmp siteHook
  db 90
BBTAG.exe+44A6D9:
  jmp cssHook
  db 90 90 90 90 90 90 90 90 90 90 90 90 90
BBTAG.exe+44A6EB:
cssReturn:

[DISABLE]
BBTAG.exe+27AAC5:
  db 8B 7D 08 8B D9
BBTAG.exe+27ABF3:
  db 8B 45 08 3D B9 06 00 00
BBTAG.exe+44CDF4:
  db 8D B7 61 01 00 00
BBTAG.exe+44A6D9:
  db 8D 8E 61 01 00 00 51 8B 8D 48 FD FF FF E8 05 05 E3 FF
unregistersymbol(slotIdTable)
dealloc(slotIdCode)
dealloc(slotIdTable)
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>21774</ID>
                      <Description>"cssCrashFix 10 (online CSS, slots 64+) "</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript Async="1">[ENABLE]
// Online character select has its own copies of the per-slot code:
//  - pal pac request at BBTAG.exe+4015E5 registers ID 0x433+slot and stores a
//    handle in [ebx+34+slot*4] (64 slots)
//  - three CSS functions look the pac up again with 0x433+slot
//    (BBTAG.exe+40838C / +40A57C / +40D8CC), use a 64-dword stack array [ebp-110]
//    (+40834B / +40A53B / +40D88B) and a 64-dword stack array [ebp-210]
//    (writes +408069 / +40A259 / +40D5A9, reads +408407 / +40A5F7 / +40D947).
//  - the loader loop at BBTAG.exe+401608 stops at a fixed 53 slots (vanilla roster).
// Slots 53+ now use IDs 0x10C0+ (handled by cssCrashFix 1), the loader runs to
// the real slot count, and the per-slot arrays live in side memory.
alloc(onlCode,$300)
alloc(onlIdx,$400)
alloc(onlArr2,$400)
alloc(onlReq,$400)
registersymbol(onlIdx)
registersymbol(onlArr2)
registersymbol(onlReq)
label(onlReg)
label(onlRegH)
label(onlLk1)
label(onlLk1H)
label(onlLk2)
label(onlLk2H)
label(onlLk3)
label(onlLk3H)
label(onlRq)
label(onlRqH)
label(onlIx1)
label(onlIx1H)
label(onlIx2)
label(onlIx2H)
label(onlIx3)
label(onlIx3H)
label(onlLoop)
label(onlFb1)
label(onlFb2)
label(onlFb3)
label(onlFb1s)
label(onlFb2s)
label(onlFb3s)

onlCode:
// --- register ID (eax = 0x433+slot)
onlReg:
  cmp esi,35
  jae onlRegH
  lea eax,[esi+433]
  jmp BBTAG.exe+4015EB
onlRegH:
  lea eax,[esi+108B]          // 0x10C0 + (slot-53)
  jmp BBTAG.exe+4015EB

// --- request handle slot (eax = [ebx+34+slot*4])
onlRq:
  cmp esi,35
  jae onlRqH
  lea eax,[ebx+esi*4+34]
  jmp BBTAG.exe+4015FB
onlRqH:
  lea eax,[onlReq+esi*4-D4]
  jmp BBTAG.exe+4015FB

// --- lookups (ecx = 0x433+slot)
onlLk1:
  cmp esi,35
  jae onlLk1H
  lea ecx,[esi+433]
  jmp BBTAG.exe+408392
onlLk1H:
  lea ecx,[esi+108B]
  jmp BBTAG.exe+408392
onlLk2:
  cmp esi,35
  jae onlLk2H
  lea ecx,[esi+433]
  jmp BBTAG.exe+40A582
onlLk2H:
  lea ecx,[esi+108B]
  jmp BBTAG.exe+40A582
onlLk3:
  cmp esi,35
  jae onlLk3H
  lea ecx,[esi+433]
  jmp BBTAG.exe+40D8D2
onlLk3H:
  lea ecx,[esi+108B]
  jmp BBTAG.exe+40D8D2

// --- [ebp-110] index array (ebx = arr[slot])
onlIx1:
  cmp esi,40
  jae onlIx1H
  lea ebx,[ebp+esi*4-110]
  jmp BBTAG.exe+408354
onlIx1H:
  lea ebx,[onlIdx+esi*4-100]
  jmp BBTAG.exe+408354
onlIx2:
  cmp esi,40
  jae onlIx2H
  lea ebx,[ebp+esi*4-110]
  jmp BBTAG.exe+40A544
onlIx2H:
  lea ebx,[onlIdx+esi*4-100]
  jmp BBTAG.exe+40A544
onlIx3:
  cmp esi,40
  jae onlIx3H
  lea ebx,[ebp+esi*4-110]
  jmp BBTAG.exe+40D894
onlIx3H:
  lea ebx,[onlIdx+esi*4-100]
  jmp BBTAG.exe+40D894

// --- loader loop end: vanilla stops at a fixed 53 slots (cmp edi,2618)
onlLoop:
  call BBTAG.exe+271E00       // roster base
  mov eax,[eax+2E00]          // slot count (your Slot Limit)
  db 69 C0 B8 00 00 00        // imul eax,eax,000000B8 (long form; short form sign-extends to -48)
  cmp edi,eax
  jl BBTAG.exe+401590
  jmp BBTAG.exe+401610

// --- fallback: slot has no pal pac (lookup returned 0) -&gt; use slot 0's (0x433),
//     same as the offline cssFallback in cssCrashFix 1
onlFb1:
  test eax,eax
  jnz onlFb1s
  push 433
  mov ecx,[ebp-2CC]
  call BBTAG.exe+27ABF0
onlFb1s:
  mov [ebp-29C],eax
  jmp BBTAG.exe+4083A4
onlFb2:
  test eax,eax
  jnz onlFb2s
  push 433
  mov ecx,[ebp-2D0]
  call BBTAG.exe+27ABF0
onlFb2s:
  mov [ebp-29C],eax
  jmp BBTAG.exe+40A594
onlFb3:
  test eax,eax
  jnz onlFb3s
  push 433
  mov ecx,[ebp-2C4]
  call BBTAG.exe+27ABF0
onlFb3s:
  mov [ebp-29C],eax
  jmp BBTAG.exe+40D8E4

BBTAG.exe+40839E:
  jmp onlFb1
  db 90
BBTAG.exe+40A58E:
  jmp onlFb2
  db 90
BBTAG.exe+40D8DE:
  jmp onlFb3
  db 90

BBTAG.exe+401608:
  jmp onlLoop
  db 90 90 90

BBTAG.exe+4015E5:
  jmp onlReg
  db 90
BBTAG.exe+4015F5:
  jmp onlRq
  db 90
BBTAG.exe+40838C:
  jmp onlLk1
  db 90
BBTAG.exe+40A57C:
  jmp onlLk2
  db 90
BBTAG.exe+40D8CC:
  jmp onlLk3
  db 90
BBTAG.exe+40834B:
  jmp onlIx1
  db 90 90 90 90
BBTAG.exe+40A53B:
  jmp onlIx2
  db 90 90 90 90
BBTAG.exe+40D88B:
  jmp onlIx3
  db 90 90 90 90

// [ebp-210] array -&gt; onlArr2 (same instruction size, all slots)
BBTAG.exe+408069:
  mov [onlArr2+esi*4],ebx
BBTAG.exe+40A259:
  mov [onlArr2+esi*4],ebx
BBTAG.exe+40D5A9:
  mov [onlArr2+esi*4],ebx
BBTAG.exe+408407:
  mov edi,[onlArr2+esi*4]
BBTAG.exe+40A5F7:
  mov edi,[onlArr2+esi*4]
BBTAG.exe+40D947:
  mov edi,[onlArr2+esi*4]

[DISABLE]
BBTAG.exe+40839E:
  db 89 85 64 FD FF FF
BBTAG.exe+40A58E:
  db 89 85 64 FD FF FF
BBTAG.exe+40D8DE:
  db 89 85 64 FD FF FF
BBTAG.exe+401608:
  db 81 FF 18 26 00 00 7C 80
BBTAG.exe+4015E5:
  db 8D 86 33 04 00 00
BBTAG.exe+4015F5:
  db 8D 43 34 8D 04 B0
BBTAG.exe+40838C:
  db 8D 8E 33 04 00 00
BBTAG.exe+40A57C:
  db 8D 8E 33 04 00 00
BBTAG.exe+40D8CC:
  db 8D 8E 33 04 00 00
BBTAG.exe+40834B:
  db 8D 9D F0 FE FF FF 8D 1C B3
BBTAG.exe+40A53B:
  db 8D 9D F0 FE FF FF 8D 1C B3
BBTAG.exe+40D88B:
  db 8D 9D F0 FE FF FF 8D 1C B3
BBTAG.exe+408069:
  db 89 9C B5 F0 FD FF FF
BBTAG.exe+40A259:
  db 89 9C B5 F0 FD FF FF
BBTAG.exe+40D5A9:
