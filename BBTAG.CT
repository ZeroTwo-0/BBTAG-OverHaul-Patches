        <CheatEntry>
          <ID>21168</ID>
          <Description>"Gallery Mode Overwrite"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript Async="1">[ENABLE]
{$lua}
if syntaxcheck then return end
autoAssemble([[
alloc(GalleryModeOverwriteMemory,$1000,BBTAG.exe)
registersymbol(GalleryModeOverwriteMemory)
]])

core.script.GalleryModeOverwrite = {}
core.script.GalleryModeOverwrite.GalJMP = AoBTools.ScanAoBTable({
    {"56 8b f1 8b 0e e8 * * * * 83"},
    {"5E E9", 0x1},
    {"5E E9", 0x1},
    {"5E E9", 0x1},
    {"5E E9", 0x1},
    {"5E E9", 0x1},
    {"5E E9", 0x1},
    {"E9", 0x1}
}, core.game.moduleAddress, core.game.moduleEndAddress)

core.script.GalleryModeOverwrite.GamePadDword = AoBTools.ScanAoBTable({
   {"24 85 * * * * 8b 47 * 83 f8 * 0f 87 * * * * FF 24 85"},
   {"FF 24", 0x3}
}, core.game.moduleAddress, core.game.moduleEndAddress)


core.script.GalleryModeOverwrite.CSSUISurvival = AoBTools.ScanAoBTable({
   {"55 8b Ec 83 EC * 53 56 57 8b d9 e8 * * * * 89 45"},
   {"E8 * * * * 85 C0 74"}
}, core.game.moduleAddress, core.game.moduleEndAddress)

core.script.GalleryModeOverwrite.CSSUISurvivalPlayer2 = AoBTools.ScanAoBTable({
   {"6A * 8d 88 * * * * e8 * * * * e8 * * * * 8B C8 e8 * * * * 85 C0"},
   {"e8 * * * * 85 C0"}
}, core.game.moduleAddress, core.game.moduleEndAddress)

core.script.GalleryModeOverwrite.CSSUISurvivalOlD = AoBTools.ScanAoBTable({
   {"56 6A * 33 F6"},
   {"E8 * * * * 85 C0 B9 * * * * 0F"}
}, core.game.moduleAddress, core.game.moduleEndAddress)

core.script.GalleryModeOverwrite.GalleryModeOriginal = readPointer(core.script.GalleryModeOverwrite.GalJMP)
core.script.GalleryModeOverwrite.CSSUISurvivalOriginal = readBytes(core.script.GalleryModeOverwrite.CSSUISurvival, 0x6, true)
core.script.GalleryModeOverwrite.CSSUISurvivalPlayer2Original = readBytes(core.script.GalleryModeOverwrite.CSSUISurvivalPlayer2, 0x6, true)
local memAddr = getAddressSafe("GalleryModeOverwriteMemory")
{$asm}
core.script.GalleryModeOverwrite.CSSUISurvival:
  call GalleryModeOverwriteMemory+300

core.script.GalleryModeOverwrite.CSSUISurvivalPlayer2:
  call GalleryModeOverwriteMemory+300

core.script.GalleryModeOverwrite.GalJMP-1:
  jmp GalleryModeOverwriteMemory

GalleryModeOverwriteMemory:
  push esi
  call BBTAG.exe+4028C0
  call BBTAG.exe+27C620
  mov [eax+00000114],00000005
  call BBTAG.exe+27C620
  mov esi,eax
  mov ecx,esi
  call BBTAG.exe+27C7C0
  imul ecx,eax,000007B0
  mov [ecx+esi+00000144],00000000
  call BBTAG.exe+27C620
  pop esi
  mov [eax+0000011C],0000000c
  ret

GalleryModeOverwriteMemory+300:
  push esi
  push -01
  xor esi,esi
  call BBTAG.exe+27C620
  mov ecx,eax
  call GalleryModeOverwriteMemory+500
  test eax,eax
  mov ecx,00000001
  cmovne esi,ecx
  mov eax,esi
  pop esi
  ret
GalleryModeOverwriteMemory+500:
  push ebp
  mov ebp,esp
  push esi
  mov esi,ecx
  cmp dword ptr [esi+00000114],01
  db 74 07 // JE
  xor eax,eax
  pop esi
  pop ebp
  ret 0004
  call BBTAG.exe+27C640
  test [eax+00000110],00020000
  db 75 25 // JNE
  xor ecx,ecx
  cmp dword ptr [esi+00000138],01
  sete cl
  cmp dword ptr [esi+000008E8],01
  lea eax,[ecx+01]
  cmovne eax,ecx
  xor ecx,ecx
  cmp eax,02
  sete cl
  test ecx,ecx
  db 75 C3 // JNE
  mov eax,[ebp+08]
  test eax,eax
  db 78 08 // JS
  cmp [esi+00002848],eax
  db 75 B4 // JNE
  imul ecx,[esi+00002848],000007B0
  xor eax,eax
  cmp dword ptr [ecx+esi+00000144],05
  je CSSUIReturn
  cmp dword ptr [ecx+esi+00000144],02
CSSUIReturn:
  pop esi
  sete al
  pop ebp
  ret 0004

[DISABLE]

{$lua}
if syntaxcheck then return end
writeInteger(core.script.GalleryModeOverwrite.GalJMP, core.script.GalleryModeOverwrite.GalleryModeOriginal)
writeBytes(core.script.GalleryModeOverwrite.CSSUISurvival, core.script.GalleryModeOverwrite.CSSUISurvivalOriginal)
writeBytes(core.script.GalleryModeOverwrite.CSSUISurvivalPlayer2, core.script.GalleryModeOverwrite.CSSUISurvivalPlayer2Original)
core.script.GalleryModeOverwrite = nil
{$asm}
unregistersymbol(GalleryModeOverwriteMemory)
dealloc(GalleryModeOverwriteMemory)
</AssemblerScript>
