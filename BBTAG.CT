        end, 60, 3000) then
    local result = AoBTools.ScanAoBTable({
        {"F7 * * * * * 00 00 80 00 0F 84 * * * * 83 * * * * * * 0F 8F * * * * FF"}
    }, core.game.moduleAddress, core.game.moduleEndAddress)
    core.script.isolateDHC = {}
    core.script.isolateDHC.origBytes = {}
    table.insert(core.script.isolateDHC.origBytes, readBytes(result, 0xA, true))
    registerSymbol("Isolate_DHC", result, true)
else
    error("Wait condition failed.")
end
{$asm}
alloc(isolateDHCMem,$1000,Isolate_DHC)

