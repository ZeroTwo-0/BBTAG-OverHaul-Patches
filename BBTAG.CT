}, core.script.IzayoiAppend.AddCheck, core.game.moduleEndAddress)
core.script.IzayoiAppend.origBytes = readBytes(core.script.IzayoiAppend.AddCheck, 0x6, true)

{$asm}
alloc(pubfuncextmem,$10000,$core.script.pubFuncExt.Address)
alloc(Appendextmem,$1000,$core.script.IzayoiAppend.AddCheck)
// Main Function
label(extendedPubFunc)
label(extendedPubFunc_return)
// relius
label(func_IGAct_DamageDelete)
label(func_IGAct_DamageBody)
label(func_IGAct_DamageEnd)
label(func_IGAct_SwitchFollow)

pubfuncextmem:
  test al,al
  je extendedPubFunc
  push edi
  jmp extendedPubFunc_return

func_customSetupBBCFRegisters:
  push esi
  push edi
  pop esi
  pop edi
  ret

extendedPubFunc:

  push name_IgnisFollow
  mov ecx,esi
  call BBTAG.exe+278450
  test al,al
  je func_IgnisAttack
  call func_customSetupBBCFRegisters
  cmp esi,03
  jne BBTAG.exe+3A61ED
  push esi
  mov ecx,ebx
  call func_IGAct_DamageDelete
  pop edi
  pop esi
  pop ebx
  mov ecx,[ebp-04]
  xor ecx,ebp
  call BBTAG.exe+6030AF
  mov esp,ebp
  pop ebp
  ret 0004
func_IgnisAttack:
  push name_IgnisAttack
  mov ecx,esi
  call BBTAG.exe+278450
  test al,al
  je func_IgnisDamage
  call func_customSetupBBCFRegisters
  cmp esi,03
  db 74 0E // je
  cmp esi,0E
  db 74 09 // je
  cmp esi,2C
  jne BBTAG.exe+3A61ED
  push esi
  mov ecx,ebx
  call func_IGAct_DamageBody
  pop edi
  pop esi
  pop ebx
  mov ecx,[ebp-04]
  xor ecx,ebp
  call BBTAG.exe+6030AF
  mov esp,ebp
  pop ebp
  ret 0004
func_IgnisDamage:
  push name_IgnisDamage
  mov ecx,esi
  call BBTAG.exe+278450
  test al,al
  je BBTAG.exe+3A61ED //next character
  call func_customSetupBBCFRegisters
  cmp esi,03
  db 74 08 // je
  test esi,esi
  jne BBTAG.exe+3A61ED
  push esi
  mov ecx,ebx
  call func_IGAct_DamageEnd
  pop edi
  pop esi
  pop ebx
  mov ecx,[ebp-04]
  xor ecx,ebp
  call BBTAG.exe+6030AF
  mov esp,ebp
  pop ebp
  ret 0004
