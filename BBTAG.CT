  test byte ptr [eax+0000006C],01
  jmp isolateDHC_return

Isolate_DHC:
  jmp isolateDHC
  nop 5
isolateDHC_return:

[DISABLE]
{$lua}
if syntaxcheck then return end
writeBytes(getAddressSafe("Isolate_DHC"), core.script.isolateDHC.origBytes[0x1])
{$asm}
unregistersymbol(Isolate_DHC)
dealloc(isolateDHCMem)
{$lua}
if syntaxcheck then return end
core.script.isolateDHC = nil
{$asm}
