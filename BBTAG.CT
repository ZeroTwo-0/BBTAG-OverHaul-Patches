                <CheatEntry>
                  <ID>21558</ID>
                  <Description>"Increased Palette Patch"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript Async="1">[ENABLE]
{$lua}
if syntaxcheck then return end

core.script.IncreasedPalettePatchValues = {}

core.script.IncreasedPalettePatchValues.paletteCount = 99

core.script.IncreasedPalettePatchValues.alloc = {}
core.script.IncreasedPalettePatchValues.alloc.injections = {}
core.script.IncreasedPalettePatchValues.limit = {}
core.script.IncreasedPalettePatchValues.limit.injections = {}

local address = core.game.moduleAddress
local index = 0x0
local cond = false
repeat
  address = AoBTools.ScanAoBTable({
      {"8B * 6A * 8B * 89 * * * * * E8 * * * * 8D"},
  }, address+0x1, core.game.moduleEndAddress)
  cond = address == nil or address &lt;= core.game.moduleAddress
  if (not cond) then
      local symbol = "Increased_Palette_Patch"..(index == 0x0 and "" or "_"..index).."_Alloc"
      local injection = {}
      injection.symbol = symbol
      injection.origBytes = readBytes(address, 0x6, true)
      table.insert(core.script.IncreasedPalettePatchValues.alloc.injections, injection)
      registerSymbol(symbol, address, true)
      address = AoBTools.ScanAoBTable({
          {"83 * * 7C * 8B"},
      }, address, core.game.moduleEndAddress)
      symbol = symbol .. "_Limit"
      local injection = {}
      injection.symbol = symbol
      injection.origBytes = readBytes(address, 0x5, true)
      injection.origJLAddr = address+0x4 + readByteSigned(address+0x4) + 0x1
      table.insert(core.script.IncreasedPalettePatchValues.limit.injections, injection)
      registerSymbol(symbol, address, true)
  end
  index = index + 0x1
until(cond)

core.script.IncreasedPalettePatchValues.cycle = {}

local result = AoBTools.ScanAoBTable({
    {"79 * C7 * * * * * * 6A 00", 0x5}
}, core.game.moduleAddress, core.game.moduleEndAddress)
registerSymbol("Increased_Palette_Patch_Cycle_Back", result, true)
core.script.IncreasedPalettePatchValues.cycle.back = {}
core.script.IncreasedPalettePatchValues.cycle.back.origBytes = readBytes(result, 0x4, true)
result = AoBTools.ScanAoBTable({
    {"83 * * * 7C * C7"}
}, result, core.game.moduleEndAddress)
registerSymbol("Increased_Palette_Patch_Cycle_Forward", result, true)
core.script.IncreasedPalettePatchValues.cycle.forward = {}
core.script.IncreasedPalettePatchValues.cycle.forward.injection = {}
core.script.IncreasedPalettePatchValues.cycle.forward.injection.origBytes = readBytes(result, 0x6, true)
core.script.IncreasedPalettePatchValues.cycle.forward.injection.origJLAddr = result+0x5 + readByteSigned(result+0x5) + 0x1

result = AoBTools.ScanAoBTable({
    {"85 * 74 * 8D * * 89 * * * * * EB * 89", 0x4}
}, core.game.moduleAddress, core.game.moduleEndAddress)
registerSymbol("Increased_Palette_Patch_Sub_Character_Index", result, true)
core.script.IncreasedPalettePatchValues.subCharIndex = {}
core.script.IncreasedPalettePatchValues.subCharIndex.injection = {}
core.script.IncreasedPalettePatchValues.subCharIndex.injection.origBytes = readBytes(result, 0x9, true)
result = AoBTools.ScanAoBTable({
    {"E8 * * * * 83 * * * 72 * * 8B * E8", 0x8}
}, core.game.moduleAddress, core.game.moduleEndAddress)
registerSymbol("Increased_Palette_Patch_Online_Limit", result, true)
core.script.IncreasedPalettePatchValues.onlineLimit = {}
core.script.IncreasedPalettePatchValues.onlineLimit.origByte = readByte(result, 0x1, true)
{$asm}
alloc(newmem,$1000)

newmem:
{$lua}
if syntaxcheck then return end
local str = ""
for i,injection in ipairs(core.script.IncreasedPalettePatchValues.alloc.injections) do
    local label = "increasedPalettePatch_Alloc"..(i == 0x1 and "" or "_"..i)
    local bytesStr =''
    for i,b in ipairs(injection.origBytes) do
        bytesStr=bytesStr..NumberToHexString(b).." "
    end
    str = str ..[[
        label(]]..label..[[)
        ]]..label..[[:
          db ]]..bytesStr.."\n"..[[
          mov [esp],core.script.IncreasedPalettePatchValues.paletteCount*2
          jmp ]]..label.."_return".."\n"..[[
    ]]
end

for i,injection in ipairs(core.script.IncreasedPalettePatchValues.limit.injections) do
    local label = "increasedPalettePatch_Limit"..(i == 0x1 and "" or "_"..i)
    str = str ..[[
        label(]]..label..[[)
        ]]..label..[[:
          cmp edi,core.script.IncreasedPalettePatchValues.paletteCount*2
          jl ]]..NumberToHexString(injection.origJLAddr).."\n"..[[
          jmp ]]..label.."_return".."\n"..[[
    ]]
end
return str
{$asm}

label(increasedPalettePatch_Cycle_Forward)
increasedPalettePatch_Cycle_Forward:
{$lua}
if syntaxcheck then return end
local bytes = {}
table.insert(bytes, 0x81)
table.insert(bytes, core.script.IncreasedPalettePatchValues.cycle.forward.injection.origBytes[0x2])
table.insert(bytes, core.script.IncreasedPalettePatchValues.cycle.forward.injection.origBytes[0x3])
local dwBytes = dwordToByteTable(core.script.IncreasedPalettePatchValues.paletteCount)
for i, b in ipairs(dwBytes) do
  table.insert(bytes, b)
end

local str = "db "
for i,b in ipairs(bytes) do
    str=str..NumberToHexString(b).." "
end
return str
{$asm}
  jl core.script.IncreasedPalettePatchValues.cycle.forward.injection.origJLAddr
  jmp increasedPalettePatch_Cycle_Forward_return

label(increasedPalettePatch_SubCharIndex)
increasedPalettePatch_SubCharIndex:
  lea eax,[ebx+core.script.IncreasedPalettePatchValues.paletteCount]
{$lua}
if syntaxcheck then return end
local str = "db "
for i,b in ipairs(core.script.IncreasedPalettePatchValues.subCharIndex.injection.origBytes) do
    if i &gt; 0x3 then
      str=str..NumberToHexString(b).." "
    end
end
return str
{$asm}
  jmp increasedPalettePatch_SubCharIndex_return

{$lua}
if syntaxcheck then return end
local str = ""
for i,injection in ipairs(core.script.IncreasedPalettePatchValues.alloc.injections) do
    local label = "increasedPalettePatch_Alloc"..(i == 0x1 and "" or "_"..i)
    str = str ..[[
        ]]..injection.symbol..[[:
          jmp ]]..label.."\n"..[[
          nop
        ]]..label.."_return"..[[:
    ]]
end

for i,injection in ipairs(core.script.IncreasedPalettePatchValues.limit.injections) do
    local label = "increasedPalettePatch_Limit"..(i == 0x1 and "" or "_"..i)
    str = str ..[[
        ]]..injection.symbol..[[:
          jmp ]]..label.."\n"..[[
        ]]..label.."_return"..[[:
    ]]
end
return str
{$asm}

Increased_Palette_Patch_Cycle_Back:
{$lua}
if syntaxcheck then return end
local bytes = {}
local dwBytes = dwordToByteTable(core.script.IncreasedPalettePatchValues.paletteCount-0x1)
for i, b in ipairs(dwBytes) do
  table.insert(bytes, b)
end
local str = "db "
for i,b in ipairs(bytes) do
    str=str..NumberToHexString(b).." "
end
return str
{$asm}

Increased_Palette_Patch_Cycle_Forward:
  jmp increasedPalettePatch_Cycle_Forward
  nop
increasedPalettePatch_Cycle_Forward_return:

Increased_Palette_Patch_Sub_Character_Index:
  jmp increasedPalettePatch_SubCharIndex
  nop 4
increasedPalettePatch_SubCharIndex_return:

Increased_Palette_Patch_Online_Limit:
  db core.script.IncreasedPalettePatchValues.paletteCount

[DISABLE]
{$lua}
if syntaxcheck then return end
for i,injection in ipairs(core.script.IncreasedPalettePatchValues.alloc.injections) do
    address = getAddressSafe(injection.symbol)
    if address ~= nil and address &gt; core.game.moduleAddress then
        writeBytes(address, injection.origBytes)
    end
end
for i,injection in ipairs(core.script.IncreasedPalettePatchValues.limit.injections) do
    address = getAddressSafe(injection.symbol)
    if address ~= nil and address &gt; core.game.moduleAddress then
        writeBytes(address, injection.origBytes)
    end
end
{$asm}

{$lua}
if syntaxcheck then return end
writeBytes(getAddressSafe("Increased_Palette_Patch_Cycle_Back"), core.script.IncreasedPalettePatchValues.cycle.back.origBytes)
{$asm}
unregistersymbol(Increased_Palette_Patch_Cycle_Back)

{$lua}
if syntaxcheck then return end
writeBytes(getAddressSafe("Increased_Palette_Patch_Cycle_Forward"), core.script.IncreasedPalettePatchValues.cycle.forward.injection.origBytes)
{$asm}
unregistersymbol(Increased_Palette_Patch_Cycle_Forward)

{$lua}
if syntaxcheck then return end
writeBytes(getAddressSafe("Increased_Palette_Patch_Sub_Character_Index"), core.script.IncreasedPalettePatchValues.subCharIndex.injection.origBytes)
{$asm}
unregistersymbol(Increased_Palette_Patch_Sub_Character_Index)

{$lua}
if syntaxcheck then return end
writeByte(getAddressSafe("Increased_Palette_Patch_Online_Limit"), core.script.IncreasedPalettePatchValues.onlineLimit.origByte)
{$asm}
unregistersymbol(Increased_Palette_Patch_Online_Limit)

{$lua}
if syntaxcheck then return end
core.script.IncreasedPalettePatchValues = nil
{$asm}
dealloc(newmem)
