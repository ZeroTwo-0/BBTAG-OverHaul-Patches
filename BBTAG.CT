                  <ID>21547</ID>
                  <Description>"Move Condition Extension"</Description>
                  <Options moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript Async="1">[ENABLE]
{$lua}
if syntaxcheck then return end
if not GeneralTools.WaitForCondition(function()
    return (not isNilAddress(getAddressSafe("Custom_IsResonanceActive")))
        end, 60, 3000) then
    error("Wait condition failed.")
end
local result = AoBTools.ScanAoBTable({
    {"81 * 00 30 00 00 0F 8F * * * * 0F 84", 0x8, {AoBTools.AoBPointerType.FarJump}},
    {"81 C1"}
}, core.game.moduleAddress, core.game.moduleEndAddress)
core.script.bbscriptMoveCondExtValues = {}
core.script.bbscriptMoveCondExtValues.OrigAddBytes = readBytes(result+0x2, 0x4, true)
core.script.bbscriptMoveCondExtValues.AddValue = readIntegerSigned(result+0x2)
core.script.bbscriptMoveCondExtValues.Address = result
{$asm}
alloc(bbsmcextmem,$10000,$core.script.bbscriptMoveCondExtValues.Address)

label(bbscriptMoveConditionExtension)
label(bbscriptMoveConditionExtension_return)

bbsmcextmem:

bbscriptMoveConditionExtension:
  cmp ecx,00004000
  jg bbscriptMoveConditionExtension_4K
  je moveCond_4000
  add ecx,core.script.bbscriptMoveCondExtValues.AddValue
  jmp bbscriptMoveConditionExtension_return
bbscriptMoveConditionExtension_4K:
  add ecx,FFFFBFFF
  cmp ecx,09
  ja moveCond_false
  jmp dword ptr [ecx*4+moveCond_4K_Pointers]

moveCond_4K_Pointers:
  dd moveCond_4001
  dd moveCond_4002
  dd moveCond_4003
  dd moveCond_4004
  dd moveCond_4005
  dd moveCond_4006
  dd moveCond_4007
  dd moveCond_4008
  dd moveCond_4009
  dd moveCond_400A



moveCond_4000:
  push ecx
  mov ecx,esi
  call Custom_IsResonanceActive
  pop ecx
  jmp moveCond_end

moveCond_4001:
  mov eax,[edi+30]
  and eax,80000001
  db 79 05
  dec eax
  or eax,-02
  inc eax
  push 00004E20 // 20000 Heat
  jmp BBTAG.exe+3BEAB8

moveCond_4002:
  mov eax,[edi+30]
  and eax,80000001
  db 79 05
  dec eax
  or eax,-02
  inc eax
  push 00000C35 // 3125 Heat
  jmp BBTAG.exe+3BEAB8

moveCond_4003:
  mov eax,[edi+30]
  and eax,80000001
  db 79 05
  dec eax
  or eax,-02
  inc eax
  push 0000186A // 6250 Heat
  jmp BBTAG.exe+3BEAB8

moveCond_4004:
  mov eax,[edi+30]
  and eax,80000001
  db 79 05
  dec eax
  or eax,-02
  inc eax
  push 0000249F // 9375 Heat
  jmp BBTAG.exe+3BEAB8

moveCond_4005:
  mov eax,[edi+30]
  and eax,80000001
  db 79 05
  dec eax
  or eax,-02
  inc eax
  push 000030D4 // 12500 Heat
  jmp BBTAG.exe+3BEAB8

moveCond_4006:
  mov eax,[edi+30]
  and eax,80000001
  db 79 05
  dec eax
  or eax,-02
  inc eax
  push 000061A8 // 25000 (4 Heat Meter)
  jmp BBTAG.exe+3BEAB8


moveCond_4007:
  mov ecx,edi
  sub esp,08 // Persona Cards
  mov eax,esp
  mov [eax],00000002
  mov [eax+04],000000DA
  call BBTAG.exe+3634B0
  test eax,eax
  jne moveCond_true
  jmp moveCond_false

moveCond_4008:
  mov ecx,edi
  sub esp,08 // Mini Jump
  mov eax,esp
  mov [eax],00000002
  mov [eax+04],000000DB
  call BBTAG.exe+3634B0
  test eax,eax
  je moveCond_true
  jmp moveCond_false

moveCond_4009:
  mov ecx,edi
  sub esp,08 // Awakening
  mov eax,esp
  mov [eax],00000002
  mov [eax+04],000000DC
  call BBTAG.exe+3634B0
  test eax,eax
  jne moveCond_true
  jmp moveCond_false

moveCond_400A:
  mov eax,[edi+30]
  and eax,80000001
  db 79 05
  dec eax
  or eax,-02
  inc eax
  push 00003A98 // 15000 (3 Heat Meter)
  jmp BBTAG.exe+3BEAB8

moveCond_true:
  mov eax,00000001
  jmp moveCond_end
moveCond_false:
  xor eax,eax
moveCond_end:
  pop edi
  pop esi
  pop ebx
  mov esp,ebp
  pop ebp
  ret 0004

core.script.bbscriptMoveCondExtValues.Address:
  jmp bbscriptMoveConditionExtension
  nop
bbscriptMoveConditionExtension_return:

[DISABLE]

core.script.bbscriptMoveCondExtValues.Address:
  db 81 C1
{$lua}
if syntaxcheck then return end
writeBytes(core.script.bbscriptMoveCondExtValues.Address+0x2, core.script.bbscriptMoveCondExtValues.OrigAddBytes)
core.script.bbscriptMoveCondExtValues = nil
{$asm}
dealloc(bbsmcextmem)
</AssemblerScript>
