ExGaugeIntpTakeover:
    call BBTAG.exe+27C620 //get character base
    mov esi,[ebx+000011DC]
    mov eax,[eax+esi*4+0000490C]
    mov eax,[eax+000028E8]
    cmp eax, [KokonoeID]
    je KokonoeInterpolation
    cmp eax, [AdachiID]
    je AdachiInterpolation
    cmp eax, [JunpeiID]
    je JunpeiInterpolation
    cmp eax, [EltnumID]
    je EltnumInterpolation
GeneralInterpolation:
    fstp dword ptr [ebx+00001148]
    jmp core.script.UI.ExGuageInterpolationEnd

KokonoeInterpolation:
    mov eax,[ebx+0000141C]
    jmp dword ptr [eax*4+KokonoeInterpPointerList]
KokonoeG2Interp:
    fadd dword ptr [KokonoeXInterp2]
    jmp GeneralInterpolation
KokonoeG3Interp:
    fadd dword ptr [KokonoeXInterp3]
    jmp GeneralInterpolation

AdachiInterpolation:
    mov eax,[ebx+0000141C]
    jmp dword ptr [eax*4+AdachiInterpPointerList]
AdachiG2Interp:
    fadd dword ptr [AdachiXInterp2]
    jmp GeneralInterpolation

JunpeiInterpolation:
    mov eax,[ebx+0000141C]
    cmp eax,2
    je JunpeiNumberInterpolation
    fadd dword ptr [JunpeiXInterp]
    jmp GeneralInterpolation
JunpeiNumberInterpolation:
    mov eax,[ebx+000011DC]
    cmp eax,0
    je JunpeiRegInterpolation
    cmp eax,2
    je JunpeiRegInterpolation
    fadd dword ptr [JunpeiXInterp1P2]
    jmp GeneralInterpolation
JunpeiRegInterpolation:
    fadd dword ptr [JunpeiXInterp1]
    jmp GeneralInterpolation

EltnumInterpolation:
    mov eax,[ebx+000011DC]
    cmp eax,0
    je GeneralInterpolation
    cmp eax,2
    je GeneralInterpolation
    fadd dword ptr [EltnumXInterp1]
    jmp GeneralInterpolation
EltnumRegInterpolation:
    fadd dword ptr [JunpeiXInterp1]
    jmp GeneralInterpolation

KokonoeXInterp2:
  db 00 00 48 C2
KokonoeXInterp3:
  db 00 00 DC C2
AdachiXInterp2:
  db 00 00 F8 C2
JunpeiXInterp:
  db 00 00 00 42
JunpeiXInterp1:
  db 00 00 7f C3
JunpeiXInterp1P2:
  db 00 00 84 C3
EltnumXInterp1:
  db 00 00 20 43

KokonoeInterpPointerList:
