  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"Core  / Geo Stuff"</Description>
      <Options moDeactivateChildrenAsWell="1"/>
      <Color>FBA6FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript Async="1">{$lua}
if syntaxcheck then return end
[ENABLE]
GeneralTools.WaitCanceled = false
Is64Bit = targetIs64Bit() PointerSize = Is64Bit and 0x8 or 0x4
core = {}
core.game = {}
core.game.moduleName = process
core.game.moduleAddress = getAddressSafe(core.game.moduleName) or 0x0
core.game.moduleSize = getModuleSize(core.game.moduleName) or -1
core.game.moduleEndAddress = core.game.moduleAddress + core.game.moduleSize
core.game.peFileInfo = ExecutableTools.ParsePEFile(core.game.moduleAddress)
core.static = {}
core.script = {}
psynchronize(function()
    local children = MemoryRecordTools.GetChildren(memrec, true)
    for i, c in ipairs(children) do
        if c.DontSave == true then
            pcall(memoryrecord_delete, c)
        else
            c.Active = false
        end
    end
    children = MemoryRecordTools.GetChildren(memrec, false)
    for i, c in ipairs(children) do c.Active = true end
end)
sleep(2000)
MemoryRecordTools.CollapseChildren(memrec, true)
local parallel = getCPUCount()
if parallel &gt;= 0x10 then
    parallel = parallel &gt;&gt; 0x1
elseif parallel &lt;= 0x8 then
    parallel = parallel - 0x1
end
if parallel == 0x0 then parallel = 0x1 end
core.DefaultParallel = parallel
[DISABLE]
core = nil
{$asm}
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>3452</ID>
          <Description>"Setup"</Description>
          <Options moHideChildren="1" moDefaultCollapsed="1" moManualExpandCollapse="1" moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript Async="1">{$lua}
if syntaxcheck then return end
[ENABLE]
GeneralTools.WaitCanceled = false
core.setup = {}
core.setup.WatchedStructures = ThreadTools.CreateWatcherGroup()
MemoryRecordTools.CollapseChildren(memrec, true)
[DISABLE]
GeneralTools.WaitCanceled = true
core.setup.WatchedStructures.Terminate()
core.setup.WatchedStructures = nil
psynchronize(function()
    local addressList = getAddressList()
    local dropDownListsMemRec = addressList.getMemoryRecordByDescription('#Drop Down Lists')
    local children = MemoryRecordTools.GetChildren(dropDownListsMemRec)
    for i, c in ipairs(children) do
        if c and c.DontSave == true then pcall(memoryrecord_delete, c) end
    end
end)
{$asm}
</AssemblerScript>
