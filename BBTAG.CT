bbscriptControlObjectExtension_GetControlObj_jmptbl:
{$lua}
if syntaxcheck then return end
local s=''
for i=0x0,core.script.bbscriptCtrlObjExtValues.GetObj.Limit do
  local str = NumberToHexString(readPointer(core.script.bbscriptCtrlObjExtValues.GetObj.JumpTableAddress+((i)*0x4)))
  if i &gt;= 0xD and i &lt;= 0x14 then
      str = 'bbscriptControlObjectExtension_GetControlObj_Ext'..(i-0xC)
  end
  s=s..'dd '..str..'\n  '
end
return s
{$asm}

